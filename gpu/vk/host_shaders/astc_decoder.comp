const uint GOB_SIZE_X_SHIFT = 6u;
const uint GOB_SIZE_Y_SHIFT = 3u;
const uint GOB_SIZE_SHIFT = GOB_SIZE_X_SHIFT + GOB_SIZE_Y_SHIFT;

const uint BYTES_PER_BLOCK_LOG2 = 4u;

const uint JUST_BITS = 0u;
const uint QUINT = 1u;
const uint TRIT = 2u;

// ASTC Encodings data, sorted in ascending order based on their BitLength value
// (see GetBitLength() function)
const uint encoding_values[22] = uint[](
    (JUST_BITS), (JUST_BITS | (1u << 8u)), (TRIT), (JUST_BITS | (2u << 8u)),
    (QUINT), (TRIT | (1u << 8u)), (JUST_BITS | (3u << 8u)), (QUINT | (1u << 8u)),
    (TRIT | (2u << 8u)), (JUST_BITS | (4u << 8u)), (QUINT | (2u << 8u)), (TRIT | (3u << 8u)),
    (JUST_BITS | (5u << 8u)), (QUINT | (3u << 8u)), (TRIT | (4u << 8u)), (JUST_BITS | (6u << 8u)),
    (QUINT | (4u << 8u)), (TRIT | (5u << 8u)), (JUST_BITS | (7u << 8u)), (QUINT | (5u << 8u)),
    (TRIT | (6u << 8u)), (JUST_BITS | (8u << 8u)));

#define MAX_WEIGHT_VALUES 64u

// Per-invocation scratch kept in on-chip LDS (4 KB/workgroup, stride 65 for bank-conflict-free
// Wave32/Wave64 access) instead of dynamically-indexed private arrays that spill to VRAM scratch.
// Phase 1 holds <=32 decoded color values (0..255); Phase 2 holds <=64 unquantized weights (0..64).
// Each invocation accesses only its own column [tid], so no workgroup barrier() is needed.
shared uint s_buf[16][65];

// Input ASTC texture globals
int total_bitsread = 0;
uvec4 local_buff;

// Color/weight bit-stream globals
uvec4 color_endpoint_data;
int color_bitsread = 0;

uint result_index = 0u;
uint result_vector_max_index = 0u;
bool result_limit_reached = false;
uint pack_word = 0u;

void EmitByte(uint tid, uint val) {
    if (result_index >= result_vector_max_index) {
        result_limit_reached = true;
        return;
    }
    const uint lane = result_index & 3u;
    if (lane == 0u) {
        pack_word = val & 0xFFu;
    } else {
        pack_word |= (val & 0xFFu) << (lane << 3u);
    }
    if (lane == 3u) {
        s_buf[result_index >> 2u][tid] = pack_word;
    }
    ++result_index;
}

void FlushBytes(uint tid) {
    if ((result_index & 3u) != 0u) {
        s_buf[result_index >> 2u][tid] = pack_word;
    }
}

uint LoadByte(uint tid, uint idx) {
    return bitfieldExtract(s_buf[idx >> 2u][tid], int((idx & 3u) << 3u), 8);
}

uint Uvec4At(uvec4 v, int idx) {
    return idx == 0 ? v.x : (idx == 1 ? v.y : (idx == 2 ? v.z : v.w));
}

uvec4 ReplicateByteTo16(uvec4 value) {
    return value * 0x101u;
}

uint ReplicateBitTo7(uint value) {
    return value * 127u;
}

uint ReplicateBitTo9(uint value) {
    return value * 511u;
}

uint FastReplicateTo8(uint value, uint num_bits) {
    if (value == 0u || num_bits == 0u) {
        return 0u;
    }
    if (num_bits >= 8u) {
        return value;
    }
    const uint v = value & ((1u << num_bits) - 1u);
    switch (num_bits) {
    case 1u: return v * 0xFFu;
    case 2u: return v * 0x55u;
    case 3u: return (v << 5u) | (v << 2u) | (v >> 1u);
    case 4u: return v * 0x11u;
    case 5u: return (v << 3u) | (v >> 2u);
    case 6u: return (v << 2u) | (v >> 4u);
    default: return (v << 1u) | (v >> 6u); // 7 bits
    }
}

uint Div3Floor(uint v) {
    return (v * 0x5556u) >> 16u;
}

uint Div3Ceil(uint v) {
    return Div3Floor(v + 2u);
}

uint Div5Floor(uint v) {
    return (v * 0x3334u) >> 16u;
}

uint Div5Ceil(uint v) {
    return Div5Floor(v + 4u);
}

uint Hash52(uint p) {
    p ^= p >> 15u;
    p -= p << 17u;
    p += p << 7u;
    p += p << 4u;
    p ^= p >> 5u;
    p += p << 16u;
    p ^= p >> 7u;
    p ^= p >> 3u;
    p ^= p << 6u;
    p ^= p >> 17u;
    return p;
}

struct PartitionParams {
    uint s1, s2, s3, s4, s5, s6, s7, s8;
    uint o1, o2, o3, o4;
};

PartitionParams Prepare2DPartition(uint seed, uint partition_count) {
    seed += (partition_count - 1u) * 1024u;
    const uint rnum = Hash52(seed);
    uint seed1 = rnum & 0xFu;
    uint seed2 = (rnum >> 4u) & 0xFu;
    uint seed3 = (rnum >> 8u) & 0xFu;
    uint seed4 = (rnum >> 12u) & 0xFu;
    uint seed5 = (rnum >> 16u) & 0xFu;
    uint seed6 = (rnum >> 20u) & 0xFu;
    uint seed7 = (rnum >> 24u) & 0xFu;
    uint seed8 = (rnum >> 28u) & 0xFu;

    seed1 *= seed1;
    seed2 *= seed2;
    seed3 *= seed3;
    seed4 *= seed4;
    seed5 *= seed5;
    seed6 *= seed6;
    seed7 *= seed7;
    seed8 *= seed8;

    uint sh1, sh2;
    if ((seed & 1u) > 0u) {
        sh1 = (seed & 2u) > 0u ? 4u : 5u;
        sh2 = (partition_count == 3u) ? 6u : 5u;
    } else {
        sh1 = (partition_count == 3u) ? 6u : 5u;
        sh2 = (seed & 2u) > 0u ? 4u : 5u;
    }
    seed1 >>= sh1;
    seed2 >>= sh2;
    seed3 >>= sh1;
    seed4 >>= sh2;
    seed5 >>= sh1;
    seed6 >>= sh2;
    seed7 >>= sh1;
    seed8 >>= sh2;

    if ((block_dims.y * block_dims.x) < 32u) {
        seed1 <<= 1u;
        seed2 <<= 1u;
        seed3 <<= 1u;
        seed4 <<= 1u;
        seed5 <<= 1u;
        seed6 <<= 1u;
        seed7 <<= 1u;
        seed8 <<= 1u;
    }

    PartitionParams pp;
    pp.s1 = seed1; pp.s2 = seed2; pp.s3 = seed3; pp.s4 = seed4;
    pp.s5 = seed5; pp.s6 = seed6; pp.s7 = seed7; pp.s8 = seed8;
    pp.o1 = rnum >> 14u;
    pp.o2 = rnum >> 10u;
    pp.o3 = rnum >> 6u;
    pp.o4 = rnum >> 2u;
    return pp;
}

uint ExtractBits(uvec4 payload, int offset, int bits) {
    if (bits <= 0 || bits > 32) {
        return 0u;
    }
    const int last_offset = offset + bits - 1;
    const int shifted_offset = offset >> 5;
    if ((last_offset >> 5) == shifted_offset) {
        return bitfieldExtract(Uvec4At(payload, shifted_offset), offset & 31, bits);
    }
    const int first_bits = 32 - (offset & 31);
    const uint result_first = bitfieldExtract(Uvec4At(payload, shifted_offset), offset & 31, first_bits);
    const uint result_second = bitfieldExtract(Uvec4At(payload, shifted_offset + 1), 0, bits - first_bits);
    return result_first | (result_second << first_bits);
}

uint StreamBits(uint num_bits) {
    const int int_bits = int(num_bits);
    const uint ret = ExtractBits(local_buff, total_bitsread, int_bits);
    total_bitsread += int_bits;
    return ret;
}

void SkipBits(uint num_bits) {
    total_bitsread += int(num_bits);
}

uint StreamColorBits(uint num_bits) {
    const int int_bits = int(num_bits);
    const uint ret = ExtractBits(color_endpoint_data, color_bitsread, int_bits);
    color_bitsread += int_bits;
    return ret;
}

// Returns the number of bits required to encode n_vals values.
uint GetBitLength(uint n_vals, uint encoding_index) {
    const uint packed = encoding_values[encoding_index];
    const uint encoding = packed & 0xFFu;
    const uint num_bits = (packed >> 8u) & 0xFFu;
    uint total_bits = num_bits * n_vals;
    if (encoding == TRIT) {
        total_bits += Div5Ceil(n_vals * 8u);
    } else if (encoding == QUINT) {
        total_bits += Div3Ceil(n_vals * 7u);
    }
    return total_bits;
}

uint GetNumWeightValues(uvec2 size, bool dual_plane) {
    uint n_vals = size.x * size.y;
    if (dual_plane) {
        n_vals *= 2u;
    }
    return n_vals;
}

uint GetPackedBitSize(uvec2 size, bool dual_plane, uint max_weight) {
    return GetBitLength(GetNumWeightValues(size, dual_plane), max_weight);
}

uint BitsBracket(uint bits, uint pos) {
    return (bits >> pos) & 1u;
}

uint BitsOp(uint bits, uint start, uint end) {
    const uint mask = (1u << (end - start + 1u)) - 1u;
    return (bits >> start) & mask;
}

uint UnquantizeColorValue(uint encoding, uint bitlen, uint bitval, uint D) {
    if (encoding == JUST_BITS) {
        return FastReplicateTo8(bitval, bitlen);
    }
    const uint A = ReplicateBitTo9(bitval & 1u);
    uint B = 0u, C = 0u;
    if (encoding == TRIT) {
        switch (bitlen) {
        case 1u:
            C = 204u;
            break;
        case 2u: {
            C = 93u;
            const uint b = (bitval >> 1u) & 1u;
            B = (b << 8u) | (b << 4u) | (b << 2u) | (b << 1u);
            break;
        }
        case 3u: {
            C = 44u;
            const uint cb = (bitval >> 1u) & 3u;
            B = (cb << 7u) | (cb << 2u) | cb;
            break;
        }
        case 4u: {
            C = 22u;
            const uint dcb = (bitval >> 1u) & 7u;
            B = (dcb << 6u) | dcb;
            break;
        }
        case 5u: {
            C = 11u;
            const uint edcb = (bitval >> 1u) & 0xFu;
            B = (edcb << 5u) | (edcb >> 2u);
            break;
        }
        case 6u: {
            C = 5u;
            const uint fedcb = (bitval >> 1u) & 0x1Fu;
            B = (fedcb << 4u) | (fedcb >> 4u);
            break;
        }
        }
    } else { // QUINT
        switch (bitlen) {
        case 1u:
            C = 113u;
            break;
        case 2u: {
            C = 54u;
            const uint b = (bitval >> 1u) & 1u;
            B = (b << 8u) | (b << 3u) | (b << 2u);
            break;
        }
        case 3u: {
            C = 26u;
            const uint cb = (bitval >> 1u) & 3u;
            B = (cb << 7u) | (cb << 1u) | (cb >> 1u);
            break;
        }
        case 4u: {
            C = 13u;
            const uint dcb = (bitval >> 1u) & 7u;
            B = (dcb << 6u) | (dcb >> 1u);
            break;
        }
        case 5u: {
            C = 6u;
            const uint edcb = (bitval >> 1u) & 0xFu;
            B = (edcb << 5u) | (edcb >> 3u);
            break;
        }
        }
    }
    uint T = (D * C) + B;
    T ^= A;
    return (A & 0x80u) | (T >> 2u);
}

uint UnquantizeTexelWeight(uint encoding, uint bitlen, uint bitval, uint D) {
    if (encoding == JUST_BITS) {
        if (bitlen >= 1u && bitlen <= 5u) {
            return uint(floor(0.5f + float(bitval) * 64.0f / float((1u << bitlen) - 1u)));
        }
        return bitlen == 0u ? 0u : bitval;
    }
    if (encoding == TRIT) {
        if (bitlen == 0u) return D * 32u;
        const uint b_mask = (0x3100u >> (bitlen * 4u)) & 0xFu;
        const uint b = (bitval >> 1u) & b_mask;
        uint B = 0u, C = 0u;
        switch (bitlen) {
        case 1u: C = 50u; break;
        case 2u: C = 23u; B = (b << 6u) | (b << 2u) | b; break;
        case 3u: C = 11u; B = (b << 5u) | b; break;
        }
        const uint A = ReplicateBitTo7(bitval & 1u);
        const uint res = (A & 0x20u) | (((D * C + B) ^ A) >> 2u);
        return res + (res > 32u ? 1u : 0u);
    }
    if (encoding == QUINT) {
        if (bitlen == 0u) return D * 16u;
        const uint b_mask = (0x3100u >> (bitlen * 4u)) & 0xFu;
        const uint b = (bitval >> 1u) & b_mask;
        uint B = 0u, C = 0u;
        switch (bitlen) {
        case 1u: C = 28u; break;
        case 2u: C = 13u; B = (b << 6u) | (b << 1u); break;
        }
        const uint A = ReplicateBitTo7(bitval & 1u);
        const uint res = (A & 0x20u) | (((D * C + B) ^ A) >> 2u);
        return res + (res > 32u ? 1u : 0u);
    }
    return 0u;
}

void EmitDecodedValue(uint tid, uint encoding, uint num_bits, uint bit_val, uint qt_val, bool is_color) {
    if (result_index >= result_vector_max_index) {
        result_limit_reached = true;
        return;
    }
    const uint v = is_color ? UnquantizeColorValue(encoding, num_bits, bit_val, qt_val)
                            : UnquantizeTexelWeight(encoding, num_bits, bit_val, qt_val);
    EmitByte(tid, v);
}

void DecodeQuintBlock(uint tid, uint num_bits, bool is_color) {
    uvec3 m;
    uvec4 qQ;
    m.x = StreamColorBits(num_bits);
    qQ.w = StreamColorBits(3u);
    m.y = StreamColorBits(num_bits);
    qQ.w |= StreamColorBits(2u) << 3u;
    m.z = StreamColorBits(num_bits);
    qQ.w |= StreamColorBits(2u) << 5u;
    if (BitsOp(qQ.w, 1u, 2u) == 3u && BitsOp(qQ.w, 5u, 6u) == 0u) {
        qQ.x = 4u;
        qQ.y = 4u;
        qQ.z = (BitsBracket(qQ.w, 0u) << 2u) | ((BitsBracket(qQ.w, 4u) & ~BitsBracket(qQ.w, 0u)) << 1u) |
               (BitsBracket(qQ.w, 3u) & ~BitsBracket(qQ.w, 0u));
    } else {
        uint C = 0u;
        if (BitsOp(qQ.w, 1u, 2u) == 3u) {
            qQ.z = 4u;
            C = (BitsOp(qQ.w, 3u, 4u) << 3u) | ((~BitsOp(qQ.w, 5u, 6u) & 3u) << 1u) | BitsBracket(qQ.w, 0u);
        } else {
            qQ.z = BitsOp(qQ.w, 5u, 6u);
            C = BitsOp(qQ.w, 0u, 4u);
        }
        if (BitsOp(C, 0u, 2u) == 5u) {
            qQ.y = 4u;
            qQ.x = BitsOp(C, 3u, 4u);
        } else {
            qQ.y = BitsOp(C, 3u, 4u);
            qQ.x = BitsOp(C, 0u, 2u);
        }
    }
    EmitDecodedValue(tid, QUINT, num_bits, m.x, qQ.x, is_color);
    EmitDecodedValue(tid, QUINT, num_bits, m.y, qQ.y, is_color);
    EmitDecodedValue(tid, QUINT, num_bits, m.z, qQ.z, is_color);
}

void DecodeTritBlock(uint tid, uint num_bits, bool is_color) {
    uvec4 m;
    uvec4 t;
    uvec3 Tm5t5;
    m.x = StreamColorBits(num_bits);
    Tm5t5.x = StreamColorBits(2u);
    m.y = StreamColorBits(num_bits);
    Tm5t5.x |= StreamColorBits(2u) << 2u;
    m.z = StreamColorBits(num_bits);
    Tm5t5.x |= StreamColorBits(1u) << 4u;
    m.w = StreamColorBits(num_bits);
    Tm5t5.x |= StreamColorBits(2u) << 5u;
    Tm5t5.y = StreamColorBits(num_bits);
    Tm5t5.x |= StreamColorBits(1u) << 7u;
    uint C = 0u;
    if (BitsOp(Tm5t5.x, 2u, 4u) == 7u) {
        C = (BitsOp(Tm5t5.x, 5u, 7u) << 2u) | BitsOp(Tm5t5.x, 0u, 1u);
        Tm5t5.z = 2u;
        t.w = 2u;
    } else {
        C = BitsOp(Tm5t5.x, 0u, 4u);
        if (BitsOp(Tm5t5.x, 5u, 6u) == 3u) {
            Tm5t5.z = 2u;
            t.w = BitsBracket(Tm5t5.x, 7u);
        } else {
            Tm5t5.z = BitsBracket(Tm5t5.x, 7u);
            t.w = BitsOp(Tm5t5.x, 5u, 6u);
        }
    }
    if (BitsOp(C, 0u, 1u) == 3u) {
        t.z = 2u;
        t.y = BitsBracket(C, 4u);
        t.x = (BitsBracket(C, 3u) << 1u) | (BitsBracket(C, 2u) & ~BitsBracket(C, 3u));
    } else if (BitsOp(C, 2u, 3u) == 3u) {
        t.z = 2u;
        t.y = 2u;
        t.x = BitsOp(C, 0u, 1u);
    } else {
        t.z = BitsBracket(C, 4u);
        t.y = BitsOp(C, 2u, 3u);
        t.x = (BitsBracket(C, 1u) << 1u) | (BitsBracket(C, 0u) & ~BitsBracket(C, 1u));
    }
    EmitDecodedValue(tid, TRIT, num_bits, m.x, t.x, is_color);
    EmitDecodedValue(tid, TRIT, num_bits, m.y, t.y, is_color);
    EmitDecodedValue(tid, TRIT, num_bits, m.z, t.z, is_color);
    EmitDecodedValue(tid, TRIT, num_bits, m.w, t.w, is_color);
    EmitDecodedValue(tid, TRIT, num_bits, Tm5t5.y, Tm5t5.z, is_color);
}

void DecodeIntegerSequence(uint tid, uint max_range, uint num_values, bool is_color) {
    const uint packed = encoding_values[max_range];
    const uint encoding = packed & 0xFFu;
    const uint num_bits = (packed >> 8u) & 0xFFu;
    uint vals_decoded = 0u;
    if (encoding == JUST_BITS) {
        while (vals_decoded < num_values && !result_limit_reached) {
            EmitDecodedValue(tid, JUST_BITS, num_bits, StreamColorBits(num_bits), 0u, is_color);
            ++vals_decoded;
        }
    } else if (encoding == TRIT) {
        while (vals_decoded < num_values && !result_limit_reached) {
            DecodeTritBlock(tid, num_bits, is_color);
            vals_decoded += 5u;
        }
    } else { // QUINT
        while (vals_decoded < num_values && !result_limit_reached) {
            DecodeQuintBlock(tid, num_bits, is_color);
            vals_decoded += 3u;
        }
    }
    FlushBytes(tid);
}

void DecodeColorValues(uint tid, uvec4 modes, uint num_partitions, uint color_data_bits) {
    uint num_values = ((modes.x >> 2u) + 1u) << 1u;
    if (num_partitions > 1u) num_values += ((modes.y >> 2u) + 1u) << 1u;
    if (num_partitions > 2u) num_values += ((modes.z >> 2u) + 1u) << 1u;
    if (num_partitions > 3u) num_values += ((modes.w >> 2u) + 1u) << 1u;
    // Binary search for the largest encoding within color_data_bits (monotonic in range).
    int lo = 0;
    int hi = 21;
    while (lo < hi) {
        const int mid = (lo + hi + 1) >> 1;
        if (GetBitLength(num_values, uint(mid)) <= color_data_bits) {
            lo = mid;
        } else {
            hi = mid - 1;
        }
    }
    result_vector_max_index = min(32u, num_values);
    DecodeIntegerSequence(tid, uint(lo), num_values, true);
}

ivec2 BitTransferSigned(int a, int b) {
    ivec2 transferred;
    transferred.y = b >> 1;
    transferred.y |= a & 0x80;
    transferred.x = a >> 1;
    transferred.x &= 0x3F;
    if ((transferred.x & 0x20) > 0) {
        transferred.x -= 0x40;
    }
    return transferred;
}

uvec4 ClampByte(ivec4 color) {
    return uvec4(clamp(color, 0, 255));
}

ivec4 BlueContract(int a, int r, int g, int b) {
    return ivec4(a, (r + b) >> 1, (g + b) >> 1, b);
}

bool IsHDRColorEndpointMode(uint cem) {
    return cem == 2u || cem == 3u || cem == 7u || cem == 11u || cem == 14u || cem == 15u;
}

int SignExtend(int value, uint nbits) {
    int sign_bit = 1 << (nbits - 1u);
    return (value ^ sign_bit) - sign_bit;
}

void DecodeHDREndpointMode7(uint v0, uint v1, uint v2, uint v3, out ivec3 e0, out ivec3 e1) {
    uint modeval = ((v0 & 0xC0u) >> 6u) | ((v1 & 0x80u) >> 5u) | ((v2 & 0x80u) >> 4u);

    uint majcomp;
    uint mode;
    if ((modeval & 0xCu) != 0xCu) {
        majcomp = modeval >> 2u;
        mode = modeval & 3u;
    } else if (modeval != 0xFu) {
        majcomp = modeval & 3u;
        mode = 4u;
    } else {
        majcomp = 0u;
        mode = 5u;
    }

    int red = int(v0 & 0x3Fu);
    int green = int(v1 & 0x1Fu);
    int blue = int(v2 & 0x1Fu);
    int scale = int(v3 & 0x1Fu);

    uint x0 = (v1 >> 6u) & 1u;
    uint x1 = (v1 >> 5u) & 1u;
    uint x2 = (v2 >> 6u) & 1u;
    uint x3 = (v2 >> 5u) & 1u;
    uint x4 = (v3 >> 7u) & 1u;
    uint x5 = (v3 >> 6u) & 1u;
    uint x6 = (v3 >> 5u) & 1u;

    uint ohm = 1u << mode;
    if ((ohm & 0x30u) != 0u) green |= int(x0 << 6u);
    if ((ohm & 0x3Au) != 0u) green |= int(x1 << 5u);
    if ((ohm & 0x30u) != 0u) blue |= int(x2 << 6u);
    if ((ohm & 0x3Au) != 0u) blue |= int(x3 << 5u);
    if ((ohm & 0x3Du) != 0u) scale |= int(x6 << 5u);
    if ((ohm & 0x2Du) != 0u) scale |= int(x5 << 6u);
    if ((ohm & 0x04u) != 0u) scale |= int(x4 << 7u);
    if ((ohm & 0x3Bu) != 0u) red |= int(x4 << 6u);
    if ((ohm & 0x04u) != 0u) red |= int(x3 << 6u);
    if ((ohm & 0x10u) != 0u) red |= int(x5 << 7u);
    if ((ohm & 0x0Fu) != 0u) red |= int(x2 << 7u);
    if ((ohm & 0x05u) != 0u) red |= int(x1 << 8u);
    if ((ohm & 0x0Au) != 0u) red |= int(x0 << 8u);
    if ((ohm & 0x05u) != 0u) red |= int(x0 << 9u);
    if ((ohm & 0x02u) != 0u) red |= int(x6 << 9u);
    if ((ohm & 0x01u) != 0u) red |= int(x3 << 10u);
    if ((ohm & 0x02u) != 0u) red |= int(x5 << 10u);

    const int shamt = mode == 0u ? 1 : int(mode);
    red <<= shamt;
    green <<= shamt;
    blue <<= shamt;
    scale <<= shamt;

    if (mode != 5u) {
        green = red - green;
        blue = red - blue;
    }

    if (majcomp == 1u) {
        int t = red; red = green; green = t;
    }
    if (majcomp == 2u) {
        int t = red; red = blue; blue = t;
    }

    e1 = ivec3(clamp(red, 0, 0xFFF), clamp(green, 0, 0xFFF), clamp(blue, 0, 0xFFF));
    e0 = ivec3(clamp(red - scale, 0, 0xFFF), clamp(green - scale, 0, 0xFFF),
               clamp(blue - scale, 0, 0xFFF));
}

void DecodeHDREndpointMode11(uint v0, uint v1, uint v2, uint v3, uint v4, uint v5, out ivec3 e0,
                             out ivec3 e1) {
    uint majcomp = ((v4 & 0x80u) >> 7u) | ((v5 & 0x80u) >> 6u);
    if (majcomp == 3u) {
        e0 = ivec3(int(v0 << 4u), int(v2 << 4u), int((v4 & 0x7Fu) << 5u));
        e1 = ivec3(int(v1 << 4u), int(v3 << 4u), int((v5 & 0x7Fu) << 5u));
        return;
    }

    uint mode = ((v1 & 0x80u) >> 7u) | ((v2 & 0x80u) >> 6u) | ((v3 & 0x80u) >> 5u);
    int va = int(v0 | ((v1 & 0x40u) << 2u));
    int vb0 = int(v2 & 0x3Fu);
    int vb1 = int(v3 & 0x3Fu);
    int vc = int(v1 & 0x3Fu);
    int vd0 = int(v4 & 0x7Fu);
    int vd1 = int(v5 & 0x7Fu);

    const uint dbits = (0x65656767u >> (mode * 4u)) & 0xFu;
    vd0 = SignExtend(vd0, dbits);
    vd1 = SignExtend(vd1, dbits);

    uint x0 = (v2 >> 6u) & 1u;
    uint x1 = (v3 >> 6u) & 1u;
    uint x2 = (v4 >> 6u) & 1u;
    uint x3 = (v5 >> 6u) & 1u;
    uint x4 = (v4 >> 5u) & 1u;
    uint x5 = (v5 >> 5u) & 1u;

    uint ohm = 1u << mode;
    if ((ohm & 0xA4u) != 0u) va |= int(x0 << 9u);
    if ((ohm & 0x08u) != 0u) va |= int(x2 << 9u);
    if ((ohm & 0x50u) != 0u) va |= int(x4 << 9u);
    if ((ohm & 0x50u) != 0u) va |= int(x5 << 10u);
    if ((ohm & 0xA0u) != 0u) va |= int(x1 << 10u);
    if ((ohm & 0xC0u) != 0u) va |= int(x2 << 11u);
    if ((ohm & 0x04u) != 0u) vc |= int(x1 << 6u);
    if ((ohm & 0xE8u) != 0u) vc |= int(x3 << 6u);
    if ((ohm & 0x20u) != 0u) vc |= int(x2 << 7u);
    if ((ohm & 0x5Bu) != 0u) vb0 |= int(x0 << 6u);
    if ((ohm & 0x5Bu) != 0u) vb1 |= int(x1 << 6u);
    if ((ohm & 0x12u) != 0u) vb0 |= int(x2 << 7u);
    if ((ohm & 0x12u) != 0u) vb1 |= int(x3 << 7u);

    int shamt = (int(mode) >> 1) ^ 3;
    va <<= shamt;
    vb0 <<= shamt;
    vb1 <<= shamt;
    vc <<= shamt;
    vd0 <<= shamt;
    vd1 <<= shamt;

    int r1 = clamp(va, 0, 0xFFF);
    int g1 = clamp(va - vb0, 0, 0xFFF);
    int b1 = clamp(va - vb1, 0, 0xFFF);
    int r0 = clamp(va - vc, 0, 0xFFF);
    int g0 = clamp(va - vb0 - vc - vd0, 0, 0xFFF);
    int b0 = clamp(va - vb1 - vc - vd1, 0, 0xFFF);

    if (majcomp == 1u) {
        int t;
        t = r0; r0 = g0; g0 = t;
        t = r1; r1 = g1; g1 = t;
    } else if (majcomp == 2u) {
        int t;
        t = r0; r0 = b0; b0 = t;
        t = r1; r1 = b1; b1 = t;
    }
    e0 = ivec3(r0, g0, b0);
    e1 = ivec3(r1, g1, b1);
}

void ComputeEndpoints(out uvec4 ep1, out uvec4 ep2, uint color_endpoint_mode, uint tid,
                      inout uint colvals_index) {
    switch (color_endpoint_mode) {
    case 0u: {
        const uint v0 = LoadByte(tid, colvals_index++);
        const uint v1 = LoadByte(tid, colvals_index++);
        ep1 = uvec4(0xFFu, v0, v0, v0);
        ep2 = uvec4(0xFFu, v1, v1, v1);
        break;
    }
    case 1u: {
        const uint v0 = LoadByte(tid, colvals_index++);
        const uint v1 = LoadByte(tid, colvals_index++);
        const uint L0 = (v0 >> 2u) | (v1 & 0xC0u);
        const uint L1 = min(L0 + (v1 & 0x3Fu), 0xFFu);
        ep1 = uvec4(0xFFu, L0, L0, L0);
        ep2 = uvec4(0xFFu, L1, L1, L1);
        break;
    }
    case 4u: {
        const uint v0 = LoadByte(tid, colvals_index++);
        const uint v1 = LoadByte(tid, colvals_index++);
        const uint v2 = LoadByte(tid, colvals_index++);
        const uint v3 = LoadByte(tid, colvals_index++);
        ep1 = uvec4(v2, v0, v0, v0);
        ep2 = uvec4(v3, v1, v1, v1);
        break;
    }
    case 5u: {
        int v0 = int(LoadByte(tid, colvals_index++));
        int v1 = int(LoadByte(tid, colvals_index++));
        int v2 = int(LoadByte(tid, colvals_index++));
        int v3 = int(LoadByte(tid, colvals_index++));
        ivec2 transferred = BitTransferSigned(v1, v0);
        v1 = transferred.x; v0 = transferred.y;
        transferred = BitTransferSigned(v3, v2);
        v3 = transferred.x; v2 = transferred.y;
        ep1 = ClampByte(ivec4(v2, v0, v0, v0));
        ep2 = ClampByte(ivec4(v2 + v3, v0 + v1, v0 + v1, v0 + v1));
        break;
    }
    case 6u: {
        const uint v0 = LoadByte(tid, colvals_index++);
        const uint v1 = LoadByte(tid, colvals_index++);
        const uint v2 = LoadByte(tid, colvals_index++);
        const uint v3 = LoadByte(tid, colvals_index++);
        ep1 = uvec4(0xFFu, (v0 * v3) >> 8u, (v1 * v3) >> 8u, (v2 * v3) >> 8u);
        ep2 = uvec4(0xFFu, v0, v1, v2);
        break;
    }
    case 8u: {
        const uint v0 = LoadByte(tid, colvals_index++);
        const uint v1 = LoadByte(tid, colvals_index++);
        const uint v2 = LoadByte(tid, colvals_index++);
        const uint v3 = LoadByte(tid, colvals_index++);
        const uint v4 = LoadByte(tid, colvals_index++);
        const uint v5 = LoadByte(tid, colvals_index++);
        if ((v1 + v3 + v5) >= (v0 + v2 + v4)) {
            ep1 = uvec4(0xFFu, v0, v2, v4);
            ep2 = uvec4(0xFFu, v1, v3, v5);
        } else {
            ep1 = uvec4(BlueContract(0xFF, int(v1), int(v3), int(v5)));
            ep2 = uvec4(BlueContract(0xFF, int(v0), int(v2), int(v4)));
        }
        break;
    }
    case 9u: {
        int v0 = int(LoadByte(tid, colvals_index++));
        int v1 = int(LoadByte(tid, colvals_index++));
        int v2 = int(LoadByte(tid, colvals_index++));
        int v3 = int(LoadByte(tid, colvals_index++));
        int v4 = int(LoadByte(tid, colvals_index++));
        int v5 = int(LoadByte(tid, colvals_index++));
        ivec2 transferred = BitTransferSigned(v1, v0);
        v1 = transferred.x; v0 = transferred.y;
        transferred = BitTransferSigned(v3, v2);
        v3 = transferred.x; v2 = transferred.y;
        transferred = BitTransferSigned(v5, v4);
        v5 = transferred.x; v4 = transferred.y;
        if ((v1 + v3 + v5) >= 0) {
            ep1 = ClampByte(ivec4(0xFF, v0, v2, v4));
            ep2 = ClampByte(ivec4(0xFF, v0 + v1, v2 + v3, v4 + v5));
        } else {
            ep1 = ClampByte(BlueContract(0xFF, v0 + v1, v2 + v3, v4 + v5));
            ep2 = ClampByte(BlueContract(0xFF, v0, v2, v4));
        }
        break;
    }
    case 10u: {
        const uint v0 = LoadByte(tid, colvals_index++);
        const uint v1 = LoadByte(tid, colvals_index++);
        const uint v2 = LoadByte(tid, colvals_index++);
        const uint v3 = LoadByte(tid, colvals_index++);
        const uint v4 = LoadByte(tid, colvals_index++);
        const uint v5 = LoadByte(tid, colvals_index++);
        ep1 = uvec4(v4, (v0 * v3) >> 8u, (v1 * v3) >> 8u, (v2 * v3) >> 8u);
        ep2 = uvec4(v5, v0, v1, v2);
        break;
    }
    case 12u: {
        const uint v0 = LoadByte(tid, colvals_index++);
        const uint v1 = LoadByte(tid, colvals_index++);
        const uint v2 = LoadByte(tid, colvals_index++);
        const uint v3 = LoadByte(tid, colvals_index++);
        const uint v4 = LoadByte(tid, colvals_index++);
        const uint v5 = LoadByte(tid, colvals_index++);
        const uint v6 = LoadByte(tid, colvals_index++);
        const uint v7 = LoadByte(tid, colvals_index++);
        if ((v1 + v3 + v5) >= (v0 + v2 + v4)) {
            ep1 = uvec4(v6, v0, v2, v4);
            ep2 = uvec4(v7, v1, v3, v5);
        } else {
            ep1 = uvec4(BlueContract(int(v7), int(v1), int(v3), int(v5)));
            ep2 = uvec4(BlueContract(int(v6), int(v0), int(v2), int(v4)));
        }
        break;
    }
    case 13u: {
        int v0 = int(LoadByte(tid, colvals_index++));
        int v1 = int(LoadByte(tid, colvals_index++));
        int v2 = int(LoadByte(tid, colvals_index++));
        int v3 = int(LoadByte(tid, colvals_index++));
        int v4 = int(LoadByte(tid, colvals_index++));
        int v5 = int(LoadByte(tid, colvals_index++));
        int v6 = int(LoadByte(tid, colvals_index++));
        int v7 = int(LoadByte(tid, colvals_index++));
        ivec2 transferred = BitTransferSigned(v1, v0);
        v1 = transferred.x; v0 = transferred.y;
        transferred = BitTransferSigned(v3, v2);
        v3 = transferred.x; v2 = transferred.y;
        transferred = BitTransferSigned(v5, v4);
        v5 = transferred.x; v4 = transferred.y;
        transferred = BitTransferSigned(v7, v6);
        v7 = transferred.x; v6 = transferred.y;
        if ((v1 + v3 + v5) >= 0) {
            ep1 = ClampByte(ivec4(v6, v0, v2, v4));
            ep2 = ClampByte(ivec4(v7 + v6, v0 + v1, v2 + v3, v4 + v5));
        } else {
            ep1 = ClampByte(BlueContract(v6 + v7, v0 + v1, v2 + v3, v4 + v5));
            ep2 = ClampByte(BlueContract(v6, v0, v2, v4));
        }
        break;
    }
    case 2u: {
        const uint v0 = LoadByte(tid, colvals_index++);
        const uint v1 = LoadByte(tid, colvals_index++);
        uint y0, y1;
        if (v1 >= v0) {
            y0 = v0 << 4u;
            y1 = v1 << 4u;
        } else {
            y0 = (v1 << 4u) + 8u;
            y1 = (v0 << 4u) - 8u;
        }
        ep1 = uvec4(0x780u, y0, y0, y0);
        ep2 = uvec4(0x780u, y1, y1, y1);
        break;
    }
    case 3u: {
        const uint v0 = LoadByte(tid, colvals_index++);
        const uint v1 = LoadByte(tid, colvals_index++);
        uint y0, d;
        if ((v0 & 0x80u) != 0u) {
            y0 = ((v1 & 0xE0u) << 4u) | ((v0 & 0x7Fu) << 2u);
            d = (v1 & 0x1Fu) << 2u;
        } else {
            y0 = ((v1 & 0xF0u) << 4u) | ((v0 & 0x7Fu) << 1u);
            d = (v1 & 0x0Fu) << 1u;
        }
        const uint y1 = min(y0 + d, 0xFFFu);
        ep1 = uvec4(0x780u, y0, y0, y0);
        ep2 = uvec4(0x780u, y1, y1, y1);
        break;
    }
    case 7u: {
        const uint v0 = LoadByte(tid, colvals_index++);
        const uint v1 = LoadByte(tid, colvals_index++);
        const uint v2 = LoadByte(tid, colvals_index++);
        const uint v3 = LoadByte(tid, colvals_index++);
        ivec3 e0, e1;
        DecodeHDREndpointMode7(v0, v1, v2, v3, e0, e1);
        ep1 = uvec4(0x780u, uint(e0.x), uint(e0.y), uint(e0.z));
        ep2 = uvec4(0x780u, uint(e1.x), uint(e1.y), uint(e1.z));
        break;
    }
    case 11u: {
        const uint v0 = LoadByte(tid, colvals_index++);
        const uint v1 = LoadByte(tid, colvals_index++);
        const uint v2 = LoadByte(tid, colvals_index++);
        const uint v3 = LoadByte(tid, colvals_index++);
        const uint v4 = LoadByte(tid, colvals_index++);
        const uint v5 = LoadByte(tid, colvals_index++);
        ivec3 e0, e1;
        DecodeHDREndpointMode11(v0, v1, v2, v3, v4, v5, e0, e1);
        ep1 = uvec4(0x780u, uint(e0.x), uint(e0.y), uint(e0.z));
        ep2 = uvec4(0x780u, uint(e1.x), uint(e1.y), uint(e1.z));
        break;
    }
    case 14u: {
        const uint v0 = LoadByte(tid, colvals_index++);
        const uint v1 = LoadByte(tid, colvals_index++);
        const uint v2 = LoadByte(tid, colvals_index++);
        const uint v3 = LoadByte(tid, colvals_index++);
        const uint v4 = LoadByte(tid, colvals_index++);
        const uint v5 = LoadByte(tid, colvals_index++);
        const uint v6 = LoadByte(tid, colvals_index++);
        const uint v7 = LoadByte(tid, colvals_index++);
        ivec3 e0, e1;
        DecodeHDREndpointMode11(v0, v1, v2, v3, v4, v5, e0, e1);
        ep1 = uvec4(v6, uint(e0.x), uint(e0.y), uint(e0.z));
        ep2 = uvec4(v7, uint(e1.x), uint(e1.y), uint(e1.z));
        break;
    }
    case 15u: {
        const uint v0 = LoadByte(tid, colvals_index++);
        const uint v1 = LoadByte(tid, colvals_index++);
        const uint v2 = LoadByte(tid, colvals_index++);
        const uint v3 = LoadByte(tid, colvals_index++);
        const uint v4 = LoadByte(tid, colvals_index++);
        const uint v5 = LoadByte(tid, colvals_index++);
        const uint v6 = LoadByte(tid, colvals_index++);
        const uint v7 = LoadByte(tid, colvals_index++);
        ivec3 e0, e1;
        DecodeHDREndpointMode11(v0, v1, v2, v3, v4, v5, e0, e1);
        const uint mode = ((v6 >> 7u) & 1u) | ((v7 >> 6u) & 2u);
        int a6 = int(v6 & 0x7Fu);
        int a7 = int(v7 & 0x7Fu);
        int alpha0, alpha1;
        if (mode == 3u) {
            alpha0 = a6 << 5;
            alpha1 = a7 << 5;
        } else {
            a6 |= (a7 << int(mode + 1u)) & 0x780;
            a7 &= int(0x3Fu >> mode);
            a7 ^= int(0x20u >> mode);
            a7 -= int(0x20u >> mode);
            a6 <<= int(4u - mode);
            a7 <<= int(4u - mode);
            a7 += a6;
            alpha0 = a6;
            alpha1 = clamp(a7, 0, 0xFFF);
        }
        ep1 = uvec4(uint(alpha0), uint(e0.x), uint(e0.y), uint(e0.z));
        ep2 = uvec4(uint(alpha1), uint(e1.x), uint(e1.y), uint(e1.z));
        break;
    }
    default: {
        ep1 = uvec4(0xFFu, 0xFFu, 0u, 0u);
        ep2 = uvec4(0xFFu, 0xFFu, 0u, 0u);
        break;
    }
    }
}

int FindLayout(uint mode) {
    if ((mode & 3u) != 0u) {
        if ((mode & 8u) != 0u) {
            if ((mode & 4u) != 0u) {
                if ((mode & 0x100u) != 0u) {
                    return 4;
                }
                return 3;
            }
            return 2;
        }
        if ((mode & 4u) != 0u) {
            return 1;
        }
        return 0;
    }
    if ((mode & 0x100u) != 0u) {
        if ((mode & 0x80u) != 0u) {
            if ((mode & 0x20u) != 0u) {
                return 8;
            }
            return 7;
        }
        return 9;
    }
    if ((mode & 0x80u) != 0u) {
        return 6;
    }
    return 5;
}

// (Frizti/Fritchii f52631cf6, from CheezerWheezer's Lichii) The image's size: a block at the right or bottom edge of an
// image whose size is not a multiple of the block size reaches past it. Storing those texels is undefined (robustImageAccess2
// is off); on AMD they landed in other images' memory (black blocks and a crosshatch in OoT on an RX 6750 XT, at last a GPU
// fault), where NVIDIA dropped them.
ivec3 image_extent;

void FillError(ivec3 coord, uint max_x, uint max_y) {
    for (uint j = 0u; j < max_y; ++j) {
        for (uint i = 0u; i < max_x; ++i) {
            imageStore(dest_image, coord + ivec3(int(i), int(j), 0), vec4(0.0));
        }
    }
}

void FillVoidExtentLDR(ivec3 coord, uint max_x, uint max_y) {
    SkipBits(52u);
    const float r = float(StreamBits(16u)) * (1.0f / 65535.0f);
    const float g = float(StreamBits(16u)) * (1.0f / 65535.0f);
    const float b = float(StreamBits(16u)) * (1.0f / 65535.0f);
    const float a = float(StreamBits(16u)) * (1.0f / 65535.0f);
    const vec4 color = vec4(r, g, b, a);
    for (uint j = 0u; j < max_y; ++j) {
        for (uint i = 0u; i < max_x; ++i) {
            imageStore(dest_image, coord + ivec3(int(i), int(j), 0), color);
        }
    }
}

bool IsError(uint mode) {
    if ((mode & 0x1FFu) == 0x1FCu) {
        if ((mode & 0x200u) != 0u) {
            // params.void_extent_hdr = true;
            return true;
        }
        if ((mode & 0x400u) == 0u || StreamBits(1u) == 0u) {
            return true;
        }
        return false;
    }
    if ((mode & 0xFu) == 0u) {
        return true;
    }
    if ((mode & 3u) == 0u && (mode & 0x1C0u) == 0x1C0u) {
        return true;
    }
    return false;
}

uvec2 DecodeBlockSize(uint mode) {
    uint A, B;
    switch (FindLayout(mode)) {
    case 0:
        A = (mode >> 5u) & 0x3u;
        B = (mode >> 7u) & 0x3u;
        return uvec2(B + 4u, A + 2u);
    case 1:
        A = (mode >> 5u) & 0x3u;
        B = (mode >> 7u) & 0x3u;
        return uvec2(B + 8u, A + 2u);
    case 2:
        A = (mode >> 5u) & 0x3u;
        B = (mode >> 7u) & 0x3u;
        return uvec2(A + 2u, B + 8u);
    case 3:
        A = (mode >> 5u) & 0x3u;
        B = (mode >> 7u) & 0x1u;
        return uvec2(A + 2u, B + 6u);
    case 4:
        A = (mode >> 5u) & 0x3u;
        B = (mode >> 7u) & 0x1u;
        return uvec2(B + 2u, A + 2u);
    case 5:
        A = (mode >> 5u) & 0x3u;
        return uvec2(12u, A + 2u);
    case 6:
        A = (mode >> 5u) & 0x3u;
        return uvec2(A + 2u, 12u);
    case 7:
        return uvec2(6u, 10u);
    case 8:
        return uvec2(10u, 6u);
    case 9:
        A = (mode >> 5u) & 0x3u;
        B = (mode >> 9u) & 0x3u;
        return uvec2(A + 6u, B + 6u);
    default:
        return uvec2(0u);
    }
}

uint DecodeMaxWeight(uint mode) {
    const int mode_layout = FindLayout(mode);
    uint weight_index = (mode & 0x10u) != 0u ? 1u : 0u;
    if (mode_layout < 5) {
        weight_index |= (mode & 0x3u) << 1u;
    } else {
        weight_index |= (mode & 0xCu) >> 1u;
    }
    weight_index -= 2u;
    if ((mode_layout != 9) && ((mode & 0x200u) != 0u)) {
        weight_index += 6u;
    }
    return weight_index + 1u;
}

vec4 EvalHDRTexel(uvec4 ep0, uvec4 ep1, uvec4 weight_vec, uint local_cem) {
    const uvec4 C0 = ep0 << 4u;
    const uvec4 C1 = ep1 << 4u;
    const uvec4 C = (C0 * (uvec4(64u) - weight_vec) + C1 * weight_vec + uvec4(32u)) >> 6u;
    const uvec4 E = (C & uvec4(0xF800u)) >> 11u;
    const uvec4 M = C & uvec4(0x7FFu);
    const uvec4 Mt_lo = 3u * M;
    const uvec4 Mt_mid = 4u * M - 512u;
    const uvec4 Mt_hi = 5u * M - 2048u;
    const uvec4 Mt = mix(Mt_lo, mix(Mt_mid, Mt_hi, greaterThanEqual(M, uvec4(1536u))),
                         greaterThanEqual(M, uvec4(512u)));
    const uvec4 Cf = (E << 10u) + (Mt >> 3u);
    const uvec4 half_bits = mix(Cf, uvec4(0x7BFFu), greaterThanEqual(Cf, uvec4(0x7C00u)));
    vec4 p = vec4(unpackHalf2x16(half_bits.x).x, unpackHalf2x16(half_bits.y).x,
                  unpackHalf2x16(half_bits.z).x, unpackHalf2x16(half_bits.w).x);
    if (local_cem == 14u) {
        const uint a0 = ep0.x * 0x101u;
        const uint a1 = ep1.x * 0x101u;
        const uint Ca = (a0 * (64u - weight_vec.x) + a1 * weight_vec.x + 32u) >> 6u;
        p.x = float(Ca) * (1.0f / 65535.0f);
    }
    return clamp(p, 0.0f, 1.0f).gbar;
}

void DecompressBlock(ivec3 coord, uint tid) {
    const uint max_x = min(block_dims.x, uint(image_extent.x - coord.x));
    const uint max_y = min(block_dims.y, uint(image_extent.y - coord.y));
    const uint mode = StreamBits(11u);
    if (IsError(mode)) {
        FillError(coord, max_x, max_y);
        return;
    }
    if ((mode & 0x1FFu) == 0x1FCu) {
        FillVoidExtentLDR(coord, max_x, max_y);
        return;
    }
    const uvec2 size_params = DecodeBlockSize(mode);
    if ((size_params.x > block_dims.x) || (size_params.y > block_dims.y)) {
        FillError(coord, max_x, max_y);
        return;
    }
    const uint num_partitions = StreamBits(2u) + 1u;
    const int mode_layout = FindLayout(mode);
    const bool dual_plane = (mode_layout != 9) && ((mode & 0x400u) != 0u);
    if (num_partitions > 4u || (num_partitions == 4u && dual_plane)) {
        FillError(coord, max_x, max_y);
        return;
    }
    const uint num_weight_vals = GetNumWeightValues(size_params, dual_plane);
    if (num_weight_vals > MAX_WEIGHT_VALUES) {
        FillError(coord, max_x, max_y);
        return;
    }
    uint partition_index = 1u;
    uvec4 color_endpoint_mode = uvec4(0u);
    uint base_cem = 0u;
    if (num_partitions == 1u) {
        color_endpoint_mode.x = StreamBits(4u);
        partition_index = 0u;
    } else {
        partition_index = StreamBits(10u);
        base_cem = StreamBits(6u);
    }
    const uint base_mode = base_cem & 3u;
    const uint max_weight = DecodeMaxWeight(mode);
    const uint weight_bits = GetPackedBitSize(size_params, dual_plane, max_weight);
    if (weight_bits < 24u || weight_bits > 96u) {
        FillError(coord, max_x, max_y);
        return;
    }
    uint remaining_bits = 128u - weight_bits - uint(total_bitsread);
    uint extra_cem_bits = 0u;
    if (base_mode > 0u) {
        switch (num_partitions) {
        case 2u: extra_cem_bits = 2u; break;
        case 3u: extra_cem_bits = 5u; break;
        case 4u: extra_cem_bits = 8u; break;
        default:
            FillError(coord, max_x, max_y);
            return;
        }
    }
    remaining_bits -= extra_cem_bits;
    const uint plane_selector_bits = dual_plane ? 2u : 0u;
    remaining_bits -= plane_selector_bits;
    if (remaining_bits > 128u) {
        FillError(coord, max_x, max_y);
        return;
    }
    // Read color data without dynamic vector indexing.
    const uint color_data_bits = remaining_bits;
    color_endpoint_data = uvec4(0u);
    if (remaining_bits > 0u) {
        const int nb = int(min(remaining_bits, 32u));
        color_endpoint_data.x = bitfieldExtract(StreamBits(uint(nb)), 0, nb);
        remaining_bits -= uint(nb);
    }
    if (remaining_bits > 0u) {
        const int nb = int(min(remaining_bits, 32u));
        color_endpoint_data.y = bitfieldExtract(StreamBits(uint(nb)), 0, nb);
        remaining_bits -= uint(nb);
    }
    if (remaining_bits > 0u) {
        const int nb = int(min(remaining_bits, 32u));
        color_endpoint_data.z = bitfieldExtract(StreamBits(uint(nb)), 0, nb);
        remaining_bits -= uint(nb);
    }
    if (remaining_bits > 0u) {
        const int nb = int(min(remaining_bits, 32u));
        color_endpoint_data.w = bitfieldExtract(StreamBits(uint(nb)), 0, nb);
        remaining_bits -= uint(nb);
    }
    const uint plane_index = StreamBits(plane_selector_bits);
    if (base_mode > 0u) {
        const uint extra_cem = StreamBits(extra_cem_bits);
        uint cem = ((extra_cem << 6u) | base_cem) >> 2u;
        const uint c0 = cem & 1u; cem >>= 1u;
        const uint c1 = cem & 1u; cem >>= 1u;
        uint c2 = 0u, c3 = 0u;
        if (num_partitions > 2u) { c2 = cem & 1u; cem >>= 1u; }
        if (num_partitions > 3u) { c3 = cem & 1u; cem >>= 1u; }
        const uint m0 = cem & 3u; cem >>= 2u;
        const uint m1 = cem & 3u; cem >>= 2u;
        uint m2 = 0u, m3 = 0u;
        if (num_partitions > 2u) { m2 = cem & 3u; cem >>= 2u; }
        if (num_partitions > 3u) { m3 = cem & 3u; }
        color_endpoint_mode.x = ((base_mode - (c0 == 0u ? 1u : 0u)) << 2u) | m0;
        color_endpoint_mode.y = ((base_mode - (c1 == 0u ? 1u : 0u)) << 2u) | m1;
        if (num_partitions > 2u) color_endpoint_mode.z = ((base_mode - (c2 == 0u ? 1u : 0u)) << 2u) | m2;
        if (num_partitions > 3u) color_endpoint_mode.w = ((base_mode - (c3 == 0u ? 1u : 0u)) << 2u) | m3;
    } else if (num_partitions > 1u) {
        const uint cem = base_cem >> 2u;
        color_endpoint_mode = uvec4(cem);
    }

    // Phase 1: Decode color values directly into LDS and compute scalar endpoints (no private arrays).
    DecodeColorValues(tid, color_endpoint_mode, num_partitions, color_data_bits);
    uvec4 ep0_0 = uvec4(0u), ep1_0 = uvec4(0u);
    uvec4 ep0_1 = uvec4(0u), ep1_1 = uvec4(0u);
    uvec4 ep0_2 = uvec4(0u), ep1_2 = uvec4(0u);
    uvec4 ep0_3 = uvec4(0u), ep1_3 = uvec4(0u);
    uint colvals_index = 0u;
    ComputeEndpoints(ep0_0, ep1_0, color_endpoint_mode.x, tid, colvals_index);
    if (num_partitions > 1u) ComputeEndpoints(ep0_1, ep1_1, color_endpoint_mode.y, tid, colvals_index);
    if (num_partitions > 2u) ComputeEndpoints(ep0_2, ep1_2, color_endpoint_mode.z, tid, colvals_index);
    if (num_partitions > 3u) ComputeEndpoints(ep0_3, ep1_3, color_endpoint_mode.w, tid, colvals_index);

    // Prepare bit-reversed weight stream (lowest `weight_bits` bits kept, rest zeroed).
    color_endpoint_data = bitfieldReverse(local_buff).wzyx;
    color_endpoint_data.x &= (weight_bits >= 32u) ? 0xFFFFFFFFu : ((1u << weight_bits) - 1u);
    color_endpoint_data.y &= (weight_bits >= 64u) ? 0xFFFFFFFFu : (weight_bits > 32u ? ((1u << (weight_bits - 32u)) - 1u) : 0u);
    color_endpoint_data.z &= (weight_bits >= 96u) ? 0xFFFFFFFFu : (weight_bits > 64u ? ((1u << (weight_bits - 64u)) - 1u) : 0u);
    color_endpoint_data.w = 0u;

    // Phase 2: Decode and unquantize texel weights directly into LDS.
    result_index = 0u;
    color_bitsread = 0;
    result_limit_reached = false;
    result_vector_max_index = num_weight_vals;
    DecodeIntegerSequence(tid, max_weight, num_weight_vals, false);

    // Hoist all block-invariant quantities out of the per-texel loop.
    const bool direct_grid = (size_params.x == block_dims.x) && (size_params.y == block_dims.y);
    const uint area = size_params.x * size_params.y;
    const uint Ds = direct_grid ? 0u : uint((float(block_dims.x) * 0.5f + 1024.0f) / float(block_dims.x - 1u));
    const uint Dt = direct_grid ? 0u : uint((float(block_dims.y) * 0.5f + 1024.0f) / float(block_dims.y - 1u));

    bool any_hdr = IsHDRColorEndpointMode(color_endpoint_mode.x);
    if (num_partitions > 1u) any_hdr = any_hdr || IsHDRColorEndpointMode(color_endpoint_mode.y);
    if (num_partitions > 2u) any_hdr = any_hdr || IsHDRColorEndpointMode(color_endpoint_mode.z);
    if (num_partitions > 3u) any_hdr = any_hdr || IsHDRColorEndpointMode(color_endpoint_mode.w);

    PartitionParams pp;
    if (num_partitions > 1u) {
        pp = Prepare2DPartition(partition_index, num_partitions);
    }

    const uint sec_chan = (plane_index + 1u) & 3u;
    // Pre-replicate LDR endpoints to 16-bit once per block when !any_hdr.
    const uvec4 C0_0 = !any_hdr ? ReplicateByteTo16(ep0_0) : ep0_0;
    const uvec4 C1_0 = !any_hdr ? ReplicateByteTo16(ep1_0) : ep1_0;
    const uvec4 C0_1 = num_partitions > 1u ? (!any_hdr ? ReplicateByteTo16(ep0_1) : ep0_1) : uvec4(0u);
    const uvec4 C1_1 = num_partitions > 1u ? (!any_hdr ? ReplicateByteTo16(ep1_1) : ep1_1) : uvec4(0u);
    const uvec4 C0_2 = num_partitions > 2u ? (!any_hdr ? ReplicateByteTo16(ep0_2) : ep0_2) : uvec4(0u);
    const uvec4 C1_2 = num_partitions > 2u ? (!any_hdr ? ReplicateByteTo16(ep1_2) : ep1_2) : uvec4(0u);
    const uvec4 C0_3 = num_partitions > 3u ? (!any_hdr ? ReplicateByteTo16(ep0_3) : ep0_3) : uvec4(0u);
    const uvec4 C1_3 = num_partitions > 3u ? (!any_hdr ? ReplicateByteTo16(ep1_3) : ep1_3) : uvec4(0u);

    for (uint j = 0u; j < max_y; ++j) {
        uint row_v0 = 0u, ft = 0u;
        if (direct_grid) {
            row_v0 = j * size_params.x;
        } else {
            const uint gt = ((Dt * j) * (size_params.y - 1u) + 32u) >> 6u;
            row_v0 = (gt >> 4u) * size_params.x;
            ft = gt & 0xFu;
        }
        const uint row_a = num_partitions > 1u ? (pp.s2 * j + pp.o1) : 0u;
        const uint row_b = num_partitions > 1u ? (pp.s4 * j + pp.o2) : 0u;
        const uint row_c = num_partitions > 2u ? (pp.s6 * j + pp.o3) : 0u;
        const uint row_d = num_partitions > 3u ? (pp.s8 * j + pp.o4) : 0u;
        const int y = coord.y + int(j);

        for (uint i = 0u; i < max_x; ++i) {
            uint primary_w, secondary_w = 0u;
            if (direct_grid) {
                const uint idx = row_v0 + i;
                if (!dual_plane) {
                    primary_w = LoadByte(tid, idx);
                } else {
                    primary_w = LoadByte(tid, idx * 2u);
                    secondary_w = LoadByte(tid, idx * 2u + 1u);
                }
            } else {
                const uint gs = ((Ds * i) * (size_params.x - 1u) + 32u) >> 6u;
                const uint js = gs >> 4u;
                const uint fs = gs & 0xFu;
                const uint w11 = (fs * ft + 8u) >> 4u;
                const uint w10 = ft - w11;
                const uint w01 = fs - w11;
                const uint w00 = 16u - fs - ft + w11;
                const uint v0 = row_v0 + js;
                if (!dual_plane) {
                    const uint p00 = v0 < area ? LoadByte(tid, v0) : 0u;
                    const uint p01 = (v0 + 1u) < area ? LoadByte(tid, v0 + 1u) : 0u;
                    const uint p10 = (v0 + size_params.x) < area ? LoadByte(tid, v0 + size_params.x) : 0u;
                    const uint p11 = (v0 + size_params.x + 1u) < area ? LoadByte(tid, v0 + size_params.x + 1u) : 0u;
                    primary_w = (p00 * w00 + p01 * w01 + p10 * w10 + p11 * w11 + 8u) >> 4u;
                } else {
                    uint p00 = 0u, p01 = 0u, p10 = 0u, p11 = 0u;
                    uint q00 = 0u, q01 = 0u, q10 = 0u, q11 = 0u;
                    if (v0 < area) {
                        p00 = LoadByte(tid, 2u * v0);
                        q00 = LoadByte(tid, 2u * v0 + 1u);
                    }
                    if ((v0 + 1u) < area) {
                        p01 = LoadByte(tid, 2u * (v0 + 1u));
                        q01 = LoadByte(tid, 2u * (v0 + 1u) + 1u);
                    }
                    if ((v0 + size_params.x) < area) {
                        p10 = LoadByte(tid, 2u * (v0 + size_params.x));
                        q10 = LoadByte(tid, 2u * (v0 + size_params.x) + 1u);
                    }
                    if ((v0 + size_params.x + 1u) < area) {
                        p11 = LoadByte(tid, 2u * (v0 + size_params.x + 1u));
                        q11 = LoadByte(tid, 2u * (v0 + size_params.x + 1u) + 1u);
                    }
                    primary_w = (p00 * w00 + p01 * w01 + p10 * w10 + p11 * w11 + 8u) >> 4u;
                    secondary_w = (q00 * w00 + q01 * w01 + q10 * w10 + q11 * w11 + 8u) >> 4u;
                }
            }

            uint local_cem = color_endpoint_mode.x;
            uvec4 C0 = C0_0, C1 = C1_0;
            if (num_partitions > 1u) {
                const uint a = (pp.s1 * i + row_a) & 0x3Fu;
                const uint b = (pp.s3 * i + row_b) & 0x3Fu;
                const uint c = num_partitions > 2u ? ((pp.s5 * i + row_c) & 0x3Fu) : 0u;
                const uint d = num_partitions > 3u ? ((pp.s7 * i + row_d) & 0x3Fu) : 0u;
                if (a >= b && a >= c && a >= d) {
                    local_cem = color_endpoint_mode.x; C0 = C0_0; C1 = C1_0;
                } else if (b >= c && b >= d) {
                    local_cem = color_endpoint_mode.y; C0 = C0_1; C1 = C1_1;
                } else if (c >= d) {
                    local_cem = color_endpoint_mode.z; C0 = C0_2; C1 = C1_2;
                } else {
                    local_cem = color_endpoint_mode.w; C0 = C0_3; C1 = C1_3;
                }
            }

            uvec4 wv = uvec4(primary_w);
            if (dual_plane) {
                if (sec_chan == 0u) wv.x = secondary_w;
                else if (sec_chan == 1u) wv.y = secondary_w;
                else if (sec_chan == 2u) wv.z = secondary_w;
                else wv.w = secondary_w;
            }

            vec4 out_rgba;
            if (!any_hdr) {
                const uvec4 Cf = (C0 * (uvec4(64u) - wv) + C1 * wv + uvec4(32u)) >> 6u;
                out_rgba = (vec4(Cf) * (1.0f / 65535.0f)).gbar;
            } else if (IsHDRColorEndpointMode(local_cem)) {
                out_rgba = EvalHDRTexel(C0, C1, wv, local_cem);
            } else {
                const uvec4 Cf = (ReplicateByteTo16(C0) * (uvec4(64u) - wv) + ReplicateByteTo16(C1) * wv + uvec4(32u)) >> 6u;
                out_rgba = (vec4(Cf) * (1.0f / 65535.0f)).gbar;
            }
            imageStore(dest_image, ivec3(coord.x + int(i), y, coord.z), out_rgba);
        }
    }
}

uint SwizzleOffset(uvec2 pos) {
    return ((pos.x & 32u) << 3u) |
           ((pos.y & 6u)  << 5u) |
           ((pos.x & 16u) << 1u) |
           ((pos.y & 1u)  << 4u) |
           (pos.x & 15u);
}

void main() {
    uvec3 pos = gl_GlobalInvocationID;
    // The shared BC scratch can be much larger than the mip being decoded.
    if (pos.x >= blocks_x || pos.y >= blocks_y) return;
    pos.x <<= BYTES_PER_BLOCK_LOG2;
    uint swizzle = SwizzleOffset(pos.xy);
    if (native_tiling != 0u) {
        // Switch 2 GOBs swap offset bits 5 and 6 (see block_linear_unswizzle_2d.comp).
        const uint difference = ((swizzle >> 5u) ^ (swizzle >> 6u)) & 1u;
        swizzle ^= (difference << 5u) | (difference << 6u);
    }
    const uint block_y = pos.y >> GOB_SIZE_Y_SHIFT;

    uint offset = 0u;
    offset += pos.z * layer_stride;
    offset += (block_y >> block_height) * block_size;
    offset += (block_y & block_height_mask) << GOB_SIZE_SHIFT;
    offset += (pos.x >> GOB_SIZE_X_SHIFT) << x_shift;
    offset += swizzle;

    const ivec3 coord = ivec3(gl_GlobalInvocationID * uvec3(block_dims, 1u));
    image_extent = imageSize(dest_image);
    if (any(greaterThanEqual(coord, image_extent))) {
        return;
    }
    local_buff = offset / 16u < uint(astc_data.length()) ? astc_data[offset / 16u] : uvec4(0u);
    DecompressBlock(coord, gl_LocalInvocationIndex);
}
