SW(RX_VK_AMD_COMPUTE_NOOPT_KEY, attempt, string, "off", "One 16-digit Red Tunic compute program key from RX_VK_PIPELINE_TRACE. Bypass the AMD Vulkan optimizer for that program during preparation and gameplay.")
SW(RX_VK_ANISO, player, int, "the Insert menu's anisotropic filtering row", "Anisotropy 0 to 16 (0: the game's own) over the menu row for one run.")
SW(RX_VK_ANTILAG, player, enum, "the Insert menu's AMD Anti-Lag 2 row (opts.antilag)", "0/1 overrides the Anti-Lag 2 menu row for one run; '-' leaves the VK_AMD_anti_lag extension not even enabled.")
SW(RX_VK_ASTC_BATCH, attempt, bool, "off: an ASTC texture kept as BC is transcoded one (level, layer) piece at a time", "=1 decodes, encodes and copies up to kBcLayers pieces at a time, three full barriers a group instead of three a piece.")
SW(RX_VK_ASTC_BC1, kill, bool, "on where the device has BC1: a big ASTC texture whose every block is opaque is kept as BC1", "=0 keeps every big ASTC texture as BC3, as before.")
