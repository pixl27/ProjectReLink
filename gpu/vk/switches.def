// (hookshot) The switches: every RX_, HOS_ and HOOKSHOT_ name the renderer or the host reads from the environment, one row
// each, sorted by name.
//   SW(name, kind, type, "what the game does with it unset", "what setting it does")
//   GONE(name, "the day its reads were deleted", "what a run that still sets it gets")
// The kinds and the rules are in switches.h; tests/test_switch_table.py holds the table and the source to each other.
// The rows were first written on 2026-11-16 from a reading of each switch's code: where a row and the code disagree, the
// code is right and the row wants correcting.
SW(HOOKSHOT_BUILDER_HOME, player, string, "not read by the game", "The Builder's own folder; the game only refuses it from hookshot_env.txt.")
SW(HOOKSHOT_BUILD_NAME, diag, string, "not set: the Insert menu shows the version alone", "A name for what a development run tests, shown under the version at the Insert menu's top right.")
SW(HOOKSHOT_DRIVER_ENV_SET, diag, string, "not set", "Set by the game itself before it restarts, naming the driver variable it took out; not for a run to set.")
SW(HOOKSHOT_NFC_DIR, player, string, "the user's own NFC folder (docs/nfc.md)", "The folder of NFC tag files the Insert menu's NFC tab lists (host/nn_nfp.c).")
SW(HOOKSHOT_NO_AV1_NOTICE, kill, bool, "the notice window is shown once (Windows, no AV1 decoder)", "No pop-up asking to install the AV1 Video Extension; the log line is still written.")
SW(HOOKSHOT_PREPARE_ONLY, player, bool, "off: a normal game run", "Marks a --prepare-shaders run: the renderer only compiles and saves shaders, skipping work a played run does.")
SW(HOS_AB, diag, string, "off: no A/B", "<switch>=<value>[,<seconds>[,<warm-up s>]]: after the warm-up (20 s) the switch alternates every period (3 s) between its normal value and <value>, an A/B within one run; the frame trace gets ab_side (scripts/ab_summary.py).")
SW(HOS_ASPECT, player, float, "the menu's Aspect ratio row (ultrawide=)", "Sets the picture's aspect ratio (e.g. 2.3889) over the options file's Aspect ratio.")
SW(HOS_AUDIO, kill, bool, "sound device opened", "=0 opens no sound device; the mixer still runs.")
SW(HOS_AUDIO_CHANNELS, player, int, "the menu's Audio output row, else the default device's layout", "Forces the layout the game mixes for: 6 or more is 5.1, anything else stereo.")
SW(HOS_AUDIO_DEVICE, player, string, "the saved audio device choice, else the system default", "Names the audio output device for this run, over the menu's saved device choice.")
SW(HOS_AUDIO_DUMP, diag, string, "no dump", "Writes the mixed output to the named WAV file.")
SW(HOS_AUDIO_IMMEDIATE, attempt, bool, "off: voice commands queued and applied by the mixer", "Applies each audio command at once under the lock instead of queuing it.")
SW(HOS_AUDIO_MUTE, diag, bool, "off (normal volume)", "Opens and feeds the sound device as for a player but at volume 0, for test runs.")
SW(HOS_AUDIO_NO_EFFECTS, diag, bool, "off: the mixes' effects (reverbs, delay, biquad filters, Aux) are applied", "=1 leaves every effect out: the dry sound, to compare.")
SW(HOS_AUDIO_NO_REVERB, kill, bool, "reverb on", "Skips the reverb effect in the audio mixer.")
SW(HOS_AUDIO_STATS, diag, bool, "off", "Logs once a second what voices play and where the signal is.")
SW(HOS_AUDIO_TRACE, diag, bool, "off", "Logs the audio graph's setup calls.")
SW(HOS_AUDIO_WB_DUMP, diag, string, "no dump", "Writes the first 40 wave buffers' data and voice coefficients into the named folder.")
SW(HOS_AV1_ASYNC, attempt, bool, "off: the synchronous (software) AV1 decoder is tried first", "=1 prefers the hardware asynchronous Media Foundation AV1 decoder.")
SW(HOS_AV1_MISSING, diag, bool, "off", "=1 behaves as if the Media Foundation AV1 decoder were missing, to see the message a player gets.")
SW(HOS_BG_CAP, attempt, int, "unset: off, background threads take cores as the others do", "The most cores background threads (priority above 16) hold at once while the frame's threads wait for one.")
SW(HOS_BG_RUN_US, tune, int, "2000 us", "With HOS_BG_CAP, how long a background thread that took a free core is left alone.")
SW(HOS_BG_THROTTLE, attempt, string, "300:3000: OptimizeChangeBanc runs 300 us, then sleeps 3 ms (=0 off)", "<run>:<sleep> (ms): a background thread gives its core up and sleeps <sleep> after <run> of running; =1: 300:3000.")
SW(HOS_BG_WAIT_US, tune, int, "8000 us", "With HOS_BG_CAP, how long a background thread waits under the cap before it takes any free core.")
SW(HOS_CACHE_CORES, hw, bool, "Windows: on CPUs whose L3 caches differ in size, the game is kept to the largest L3's cores", "=0 lets the game's threads run on every core.")
SW(HOS_CHAIN, diag, string, "off: one load and a branch per wait and signal", "Writes the guest threads' blocks and wake-ups to the given path, for the frame's critical path (scripts/chain.py).")
SW(HOS_COMMIT_MARK_MB, tune, int, "64 MB", "Every that many MB of a commit is marked so runs of read-write-execute pages end there; 0: no marks.")
SW(HOS_COND_RECORD, attempt, enum, "0: conditional-render conditions read at replay", "1-4: conditions (and for 3, 4 the reports) are read at record time instead of at replay.")
SW(HOS_CONTROL, diag, string, "off: no control bridge", "Starts the control bridge on the given socket path, so a local tool or test can drive the game.")
SW(HOS_CONTROL_MEM, diag, enum, "off: the control bridge cannot read or write guest memory", "ro or rw lets control bridge clients read (or read and write) the game's memory.")
SW(HOS_CONTROL_PEER_SID, diag, string, "unset: the control pipe is this user's alone", "Lets one more Windows account (by SID) connect to the control bridge's pipe.")
SW(HOS_CORES, tune, int, "6 (or the game's own count where it is set up for more)", "Sets how many cores the game sees, 1 to 8.")
SW(HOS_CORE_COUNT, diag, bool, "off", "Logs per guest thread every 5 s the calls asking for the core number and the waits for a virtual core.")
SW(HOS_CRASH_MINIDUMP, diag, bool, "off: no minidump", "=1 has a worker made at startup write a Windows minidump when the game crashes.")
SW(HOS_CRASH_TEST, diag, string, "off", "Crashes the game on purpose (=start, or after <seconds>) to see the crash window.")
SW(HOS_CRASH_WATCH, kill, bool, "on: a helper watches the run and shows a window after a crash", "=0 starts no crash helper and shows no window after a crash, for development runs.")
SW(HOS_CV_SIGNAL_ALWAYS, kill, bool, "off: a signal with no waiter returns at once", "SignalConditionVariable always takes its lock and wakes, as before.")
SW(HOS_CYCLE_ITEMS, player, enum, "the menu's Cycle items row", "0 off, 1 last used, 2 basic, 3 and bombs, 4 and the tools: over the menu's row for this run.")
SW(HOS_DAV1D_THREADS, hw, int, "dav1d's own (one per logical core); 2 on a PC with 4 or fewer", "Sets dav1d's decoder thread count.")
SW(HOS_DISCARD_HOLDS_CORE, kill, bool, "off: a thread gives its virtual core up while freed pages are discarded", "=1 keeps the core through the discard, as before.")
SW(HOS_DISCORD, kill, bool, "on: the Discord presence thread starts", "=0 starts no Discord rich presence thread at all.")
SW(HOS_DISCORD_APP_ID, player, string, "the options file's discord_app_id=, else the built-in id", "Sets the Discord application id used for rich presence, over the options file's.")
SW(HOS_DISPLAY_MODES, diag, string, "the screen's own display modes", "Gives a list of WxH display modes in place of the screen's, to check the menu's size rows for a screen you lack.")
SW(HOS_DPI_UNAWARE, kill, bool, "the process and window thread are made per-monitor DPI aware (Windows)", "=1 leaves the process DPI-unaware, as before the DPI fix.")
SW(HOS_DYNRES, player, bool, "the menu's resolution row", "Overrides the menu's dynamic resolution row for a run (0 turns the game's dynamic resolution off).")
SW(HOS_ENV_FILE, diag, string, "hookshot_env.txt in the game's folder", "Reads switches from the named file instead of hookshot_env.txt, for a scripted or A/B test run.")
SW(HOS_EVENT_WATCH_LR, diag, string, "unset: off", "A guest return address (hex): logs the signals and waits of the events signalled from there.")
SW(HOS_FIXED_TIME, diag, int, "the PC's real clock", "The game's clock starts at the given POSIX seconds at boot, so runs can be compared.")
GONE(HOS_FIX_RES, "2026-11-11", "it does nothing")
SW(HOS_FMA_FAST, kill, bool, "on: a build without FMA3 (x86-64-v2) rounds a fused multiply-add correctly ahead of suyu's exact bodies (nx2/fma_soft.h)", "=0 leaves them to suyu's exact bodies, as before.")
SW(HOS_FPCR_SYNC, kill, bool, "on: the guest's FPCR.FZ sets the host's MXCSR flush-to-zero (the hot functions' native floating point)", "=0 leaves MXCSR as it is.")
SW(HOS_FPS_CLOTH, kill, bool, "on: below 60 fps the cloth (Link's cap) steps by the frame's own time", "=0 (or off, false, no): the cloth steps 1/60 s a frame, as before.")
SW(HOS_FPS_CLOTH_60, attempt, bool, "off: above a 60 cap the cloth is solved every frame, each solve a 60th", "=1 solves the Havok cloth at most 60 times a second above a 60 cap (the game clock's whole 60ths), keeping its last pose between.")
SW(HOS_FPS_LOG, diag, bool, "off", "Logs the game's frame limiter, VRR flags, nominal rate and game clock speed every 300 presents.")
SW(HOS_FPS_MAX, player, int, "the Game frame rate cap row (frame_rate_cap in the options file)", "Sets the game's frame rate cap for a run (30 or 61-1000), over the menu's Game frame rate cap row.")
SW(HOS_FPS_MOVIE, kill, bool, "on: movie players' updates are timed by the frames' own time", "=0 turns off the timed movie update count at frame rates other than 60.")
SW(HOS_FPS_STEP, kill, bool, "on: above/below a 60 cap the game steps by the frames' own time", "=0: every frame steps 1/60 s and the rate goes up to the cap, as before.")
SW(HOS_FPS_TAKEOFF, kill, bool, "on: above a 60 cap a backflip's takeoff lifts Link's body as far as a 60 fps step would (the rest on the update after it)", "=0 (or off, false, no): the takeoff lifts it by one shorter step of the takeoff speed, as before (lower hops; a backflip down a slope can take off twice).")
SW(HOS_FPS_TARGET, attempt, int, "0: the game's frame limiter left alone", "Holds the engine's frame limiter (+0xfc) at the given fps.")
SW(HOS_FRAME_CARRY, kill, bool, "on: at a 60 cap, a step that is not a whole frame (below 60 fps) keeps its fractions in the game's whole-frame counters", "=0: at a 60 cap the game's cuts drop the fraction of a step under 60 fps (46 fps: the time of day at 77 %), as before.")
SW(HOS_FRAME_SLEEP_MS, diag, int, "0: no sleep", "Sleeps <ms> after every present, to test game speed against frame rate.")
SW(HOS_FS_DELAY_MS, diag, string, "0: no delay", "Sleeps <ms> in every file read, optionally only after <after s> (value is ms[,seconds]).")
SW(HOS_FS_OVERLAY, diag, string, "no overlay", "A test: a game data file found in the named folder is read in place of the game's own.")
SW(HOS_FS_TRACE, diag, bool, "off", "Logs every file the game opens or does not find.")
SW(HOS_FS_WATCH, diag, string, "off", "Logs file reads that land in the guest address range <lo hex>:<hi hex>.")
SW(HOS_FULLSCREEN, player, bool, "the options file's fullscreen=", "Starts fullscreen (1) or windowed (0) for a run, over the saved Fullscreen row, which is left alone.")
SW(HOS_GAME_INTERVAL, kill, bool, "off: a frame is shown as soon as it is ready (with Game speed Real time)", "=1 paces presents to the 1-4 vsync interval the game asks for, as before.")
SW(HOS_GPU_ALLOC_RETRY, kill, bool, "on: a failed material-block allocation is retried in the heap's parents", "=0: allocations from a full heap are not retried in its parents, as shipped.")
SW(HOS_GPU_ALLOC_TEST_FAIL, diag, string, "0: nothing refused", "Refuses the first n of those allocations (n or gpu,cpu) so the retry runs: fault injection.")
SW(HOS_GRAPHICS_SCALE, attempt, float, "1.0", "Another value returned by nn::oe::GetCurrentGraphicsScale, a test of whether the game sizes its picture by it.")
SW(HOS_GUEST_LIBC, kill, bool, "off: host versions of memcpy and the other libc hooks run", "The host's libc entry hooks step aside and the game's own recompiled memcpy and friends run.")
SW(HOS_GUEST_MEMFD, hw, bool, "Linux: a shared memfd where /dev/udmabuf can be opened, else anonymous memory", "0 keeps the guest window anonymous memory as before; 1 uses the memfd even without udmabuf.")
SW(HOS_GUEST_PAGES, attempt, bool, "off", "=1 turns on the guest pages module (host/hos_guestpages.c).")
SW(HOS_GUEST_PAGES_TEST, diag, bool, "off", "=1 runs the guest pages module's check at the start.")
SW(HOS_GUEST_PAGES_TEST_MB, diag, int, "256 MB", "With HOS_GUEST_PAGES_TEST, how much memory the check uses.")
SW(HOS_HANDHELD, player, bool, "the options file's handheld_profile (0: docked)", "=1 runs the game as handheld (1080p screen and its handheld resolutions) instead of docked, over the options file.")
SW(HOS_HD_RUMBLE, kill, bool, "on for Switch Pro Controllers and Joy-Cons when SDL has the effect call", "=0: HD rumble is never used; those pads get the plain motor rumble.")
SW(HOS_HEADLESS, diag, bool, "off: a window is opened", "Runs with no window: frames render to an offscreen image; no crash window, out-of-memory box or pad window.")
SW(HOS_HEAP_COMMIT, kill, bool, "Windows: the heap is reserved and committed as it is touched", "=1 commits the whole heap at once, as before.")
SW(HOS_HEAP_SPLIT, attempt, int, "unset: off", "Above 0 starts the heap split's measurement of the heaps (host/hos_heapsplit.c).")
SW(HOS_HEAP_SPLIT_COLD, attempt, int, "unset: off", "With HOS_HEAP_SPLIT, above 0 has it measure the heaps' cold pages itself, in place of the memory module.")
SW(HOS_HLE_STATS, diag, bool, "off", "Counts each HLE function's and host call's calls and logs them about every 5 s.")
SW(HOS_HOSTCALL_SLOW, kill, bool, "host calls without user data are called directly as plain functions", "=1 sends every host call through the slower a64_call_miss path, as before the direct call.")
SW(HOS_HOSTCALL_STATS, diag, bool, "off", "Counts host calls and keeps the last 256; printed at exit (or at HOS_STATS_AFTER).")
SW(HOS_HOST_SPLIT, diag, bool, "off", "Names the renderer's mapped allocations by kind, for the host's split of its memory (host/hos_hostsplit.c).")
SW(HOS_HUD_FULL_RATIO, tune, float, "1.5 (3:2)", "Sets the aspect ratio below which the 16:9 HUD is drawn smaller.")
SW(HOS_HUD_MAX_RATIO, tune, float, "2.4 (12:5)", "Sets the aspect ratio past which the HUD's side moves stop (0: the screen's edges at any width).")
SW(HOS_INPUT_BACKGROUND, player, bool, "the menu's Controller in background row (off)", "Controllers and motion count while another window has the focus (1), or never (0), over the menu.")
SW(HOS_INPUT_EXCLUSIVE, diag, bool, "off: the player's devices count during a script", "During an input script, the player's devices are ignored until 5 s after its last press.")
SW(HOS_INPUT_FRAME_CLOCK, diag, bool, "off: script time is the wall clock", "The input script's time runs at 60 game frames a second instead of the wall clock.")
SW(HOS_INPUT_LIVE, diag, string, "no file polled", "A file a test appends press lines and ! commands to, read every 30 ms.")
SW(HOS_INPUT_SCRIPT, diag, string, "no script", "A list of timed button presses fed to the game, for test runs.")
SW(HOS_INPUT_SCRIPT_BACKGROUND, diag, bool, "off", "Does nothing any more: only logs that it is no longer needed.")
SW(HOS_ITEM_WHEEL, player, bool, "the Gameplay tab's Item wheel row", "0 or 1 turns the item wheel off or on for this run, over the menu's row.")
SW(HOS_JOBTRACE, diag, string, "unset: off", "Records the game's jobs to the given path (HOS_JOBTRACE_AT, HOS_JOBTRACE_SECS).")
SW(HOS_JOBTRACE_AT, diag, float, "90 s", "With HOS_JOBTRACE, how many seconds after the start the recording begins.")
SW(HOS_JOBTRACE_SECS, diag, float, "3 s", "With HOS_JOBTRACE, how many seconds are recorded.")
SW(HOS_JOB_ORDER, attempt, bool, "off: the game's jobs run in its order", "=1 runs jobs measured over HOS_JOB_ORDER_US first in their level.")
SW(HOS_JOB_ORDER_LOG, diag, bool, "off", "With HOS_JOB_ORDER, logs the jobs moved.")
SW(HOS_JOB_ORDER_US, tune, int, "the module's own threshold", "With HOS_JOB_ORDER, the run time (us) above which a job counts as long.")
SW(HOS_KEEP_DEAD_OBJECTS, kill, bool, "off: finalized sync objects are buried and freed 30 s later", "Finalized sync objects are never buried or freed.")
SW(HOS_KEEP_DISPLAY, kill, bool, "on: the display's idle timer is reset every 30 s while the game is in front (Windows)", "=0 lets Windows turn the display off at its power plan's timeout, as before.")
SW(HOS_KEEP_FREED_PAGES, kill, bool, "freed guest pages are discarded (given back to the OS)", "=1 keeps freed guest pages committed instead of discarding them.")
SW(HOS_KEY_MESSAGES, diag, bool, "off: the keyboard's state, then the window's messages", "=1 reads keys from the window's messages alone, as on a PC whose keyboard state answers nothing (a test).")
SW(HOS_LANGUAGE, player, string, "language.txt, else English (US)", "Sets the language the game and the menu run in (e.g. pt-BR), over language.txt.")
SW(HOS_LARGE_PAGES, attempt, bool, "off: normal pages", "=1 reserves the guest window in 2 MB large pages, for fewer TLB misses.")
SW(HOS_LAZY_COMMIT, kill, bool, "on: the heap and address regions are committed where first touched", "=0 commits them whole when the game asks, as before.")
SW(HOS_LOG_BATCH_MS, tune, int, "250 ms", "Sets how often the log writer thread writes queued lines (0 to 2000 ms; 0: as they come).")
SW(HOS_LOG_QPC, diag, bool, "off", "Ends every log line with the QueryPerformanceCounter value when it was logged, to line it up with a PresentMon capture.")
SW(HOS_LOG_SYNC, kill, bool, "log lines are queued and written by a writer thread", "=1 has each thread write its own log lines, as before.")
SW(HOS_LONG_WAITS, diag, bool, "off", "Logs an untimed event wait still blocked after 5 s, with thread and caller.")
SW(HOS_MAP_TRACE, diag, bool, "off", "Logs every GPU address space mapping change in nvdrv.")
SW(HOS_MARK_BITMAP_ALL, diag, bool, "off: the lifted stores mark GPU pages only (unless built with RX_MARK_BITMAP=0)", "=1 sets every page's bit at the start, so every store marks as without the bitmap, plus its test (the control of an A/B).")
SW(HOS_MEMINFO_OLD, kill, bool, "used memory reported to the game counts its mapped pages too", "=1 reports used memory as program + system alone, as before.")
SW(HOS_MEMORY_MB, tune, int, "9809 MB (a Switch 2 application's; 3285 in the web build)", "Sets how much memory the game is told it has, in MB.")
SW(HOS_MEM_MAP, diag, bool, "off", "Logs how much of the guest window is committed and resident, with the renderer's mem: lines.")
SW(HOS_MEM_SPLIT, attempt, int, "unset: off", "Above 0 starts the memory split's thread that many seconds in (host/hos_memsplit.c).")
SW(HOS_MENU_DRAG_GAIN, tune, float, "6.0", "Gain of a mouse drag turned into the stick for the game's menus.")
SW(HOS_MENU_TRACE, diag, bool, "off", "Logs the game's menu screens, focus and the host's stick as the game reads it.")
SW(HOS_MESA_SUBMIT_THREAD_SET, diag, bool, "unset: set only by Hookshot's own start", "Marks a MESA_VK_ENABLE_SUBMIT_THREAD that Hookshot set, so a process it starts decides again; not for players.")
SW(HOS_MIC_LOG, diag, bool, "off", "Logs the microphone input's peaks as the game reads it.")
SW(HOS_MKW_INTERVAL, kill, enum, "1: MKW's pacer held at a steady 60 fps", "The interval MKW's pacer is held at: 1 is 60, 2 is 30, 0 the game's own choice.")
SW(HOS_MODS, tune, string, "the mods folder in the game's folder", "Names the folder mods are loaded from, in place of the game folder's mods.")
SW(HOS_MOTION_DEBUG, diag, bool, "off", "Logs the motion sensors' polling in pad_sdl.c.")
SW(HOS_MOUSE_DECAY, tune, float, "0.30", "How fast the mouse's stick deflection decays, as a share a step.")
SW(HOS_MOUSE_INVERT_X, player, bool, "the menu's Invert mouse horizontal row", "=1 flips the mouse camera's left and right, as the menu's Invert mouse horizontal.")
SW(HOS_MOUSE_INVERT_Y, player, bool, "the menu's Invert mouse vertical row", "=1 flips the mouse camera's up and down, as the menu's Invert mouse vertical.")
SW(HOS_MOUSE_MIN_DECAY, tune, float, "0.20", "The least the mouse's stick deflection decays a step.")
SW(HOS_MOUSE_NATIVE, player, bool, "the Insert menu's Mouse camera row (off)", "1 or 0 turns native mouse look on or off, over the menu's Mouse camera row.")
SW(HOS_MOUSE_SENS, player, float, "the menu's mouse sensitivity (or user/mouse_sens.txt, moved into the menu once)", "Sets the mouse sensitivity and stops the old mouse_sens.txt being moved into the menu.")
SW(HOS_MOUSE_TEST, diag, int, "0: the real mouse", "A test's mouse: captured, moving to the right at that many counts a second.")
SW(HOS_MOVIE_PACE, kill, bool, "on: a 60 FPS cap is raised for a movie's pictures", "=0 leaves the pacing at the frame rate cap while a movie plays.")
SW(HOS_MUTEX_IX, attempt, bool, "off: a mutex's host object is found in the lookup table", "=1 finds it by an index kept in the mutex's unused nesting-count word, checked against its key.")
SW(HOS_MUTEX_TRACE, diag, int, "0: off", "Logs mutex waits longer than <ms>, with the thread that held the mutex.")
SW(HOS_MUTEX_WATCH, diag, string, "off", "Logs every operation on the mutex at that guest address (hex) and its condition variables' signals.")
SW(HOS_MW_WAKE, kill, enum, "only changes to objects linked into a multi-wait wake WaitAny", "=all: every event, semaphore or queue change wakes every WaitAny, as before.")
SW(HOS_NAMES_NATIVE, kill, enum, "1: the name searches of f_805aeea0 run natively", "0 runs them lifted; 2 runs both and compares.")
SW(HOS_NATIVE_ZSTD, hw, enum, "the game's zstd streams decoded on the host's libzstd, the virtual core given up meanwhile (1), kept (2) on an Intel integrated GPU", "1 gives the virtual core up while it decodes, 2 keeps it, 0 decodes with the game's own zstd.")
SW(HOS_NATIVE_ZSTD_FRAMES, kill, bool, "on: the resource loaders' whole-buffer zstd is decoded on the host's libzstd", "=0 runs the game's own zstd for them (lifted code).")
SW(HOS_NFP_SEARCH, diag, bool, "off", "=1 has the game's reader look for a tag from the start, without the game's own NFC screen (a test of the Switch 2 Pro Controller's reader).")
SW(HOS_NFP_TRACE, diag, bool, "off", "=1 logs nn::nfp's application area calls.")
SW(HOS_NOACCESS_RAM, attempt, bool, "off", "=1 keeps guest RAM that is not in use no-access (not with HOS_LAZY_COMMIT=0 or large pages).")
SW(HOS_NO_DAV1D, kill, bool, "dav1d decodes the game's AV1 movies", "=1 skips dav1d, so AV1 movies decode through Media Foundation instead.")
SW(HOS_NO_HANDOFF, kill, bool, "hand-off on: a signalled waiter is owed the mutex", "Any thread may take a mutex a condition variable's woken waiter is owed, as before.")
SW(HOS_NO_MOVIES, kill, bool, "movies found and played", "The game's .webm movies are reported not found and the game goes on without them.")
SW(HOS_NO_OBJ_CACHE, kill, bool, "per-thread 1024-entry object cache on", "Every sync object lookup goes to the table instead of the per-thread cache.")
SW(HOS_NO_PACING, kill, bool, "pacing on", "The texture acquire never waits for the next frame's time: no frame pacing.")
SW(HOS_NO_PRIORITIES, kill, bool, "Windows: boosted threads get above-normal or highest priority", "=1 leaves boosted host threads at normal priority.")
SW(HOS_NO_RENDERER_WAIT, kill, bool, "the game's first GPU work waits for the renderer", "Non-zero skips the wait for the renderer before the game's first GPU work, as before lighting-fix.")
SW(HOS_NO_SDL, kill, bool, "SDL controllers on", "SDL's controller thread is never started: no SDL pads, only XInput.")
SW(HOS_NO_THP, attempt, bool, "off: THP as the system sets it outside the guest window", "=1 disables transparent huge pages for the whole process (PR_SET_THP_DISABLE).")
SW(HOS_NR_DIFF_EVERY, diag, int, "64 calls", "With a native routine in compare mode, every how many calls the two are compared.")
SW(HOS_NR_STRCMP_805AFC70, attempt, enum, "0: f_805afc70 runs lifted", "Its mode: native, or both compared (host/hos_native.c).")
SW(HOS_NVN_CHMASK_LOG, diag, bool, "off", "Logs the first 40 nvnChannelMaskStateSetChannelMask calls' arguments.")
SW(HOS_NVN_DEVINFO_LOG, diag, bool, "off", "Logs every nvnDeviceGetInteger query and its answer.")
SW(HOS_NVN_HOLD, attempt, bool, "off: command buffers go to the replay at the submit", "Holds submitted command buffers until the queue is flushed, as NVN does.")
SW(HOS_NVN_LOG_OBJECTS, diag, bool, "off", "Logs NVN object creation and setup calls.")
SW(HOS_NVN_LOG_VMAP, diag, string, "off", "Logs virtual pools and the mappings into pools from the given GPU address (hex) up.")
SW(HOS_NVN_NO_SWEEP, kill, bool, "sweep on: overwritten command recordings' copies are freed in slices", "Never sweeps the copies of command recordings the game has overwritten.")
SW(HOS_NVN_REC_SHIFT, tune, int, "16", "The page shift (12-24) the command recordings' hash buckets are keyed by.")
SW(HOS_NVN_STRICT, diag, bool, "off: an unimplemented NVN call is logged once and answered 0", "Stops the game at the first NVN call that is not implemented.")
SW(HOS_NVN_SYNC_BLOCK, attempt, bool, "off: nvnSyncWait honours the game's timeout", "An nvnSyncWait poll waits for the GPU without a timeout.")
SW(HOS_NVN_SYNC_LOG, diag, int, "off", "Logs fences, sync waits and event reads with the caller: first 30000, or 400 from the n-th present.")
SW(HOS_NVN_WATCH_DRAW, diag, string, "off", "Logs who records indexed draws of that index count (value is count[,after s]), first 60.")
SW(HOS_NVN_WATCH_DRAW_THREAD, diag, string, "every thread", "Narrows HOS_NVN_WATCH_DRAW to draws recorded on threads whose name contains the value.")
SW(HOS_NVN_WATCH_RT, diag, string, "off", "Logs who sets the render target at that guest address (hex), as guest call chains.")
SW(HOS_NVN_WATCH_TEX, diag, string, "off", "Logs who binds that texture handle (hex), as guest call chains, each once.")
SW(HOS_OCB_HOLD_MS, tune, string, "2000: a new neighbouring map to preload is taken once it stays the choice 2 s", "OoT's OptimizeChangeBank preloads one neighbouring map; where Link stands inside two maps' radii its choice flipped as he turned, each flip a cancel and a full reload. The choice is held until a new one (the same unit with the same map in it) stays chosen this many ms; 0, a negative number or off: the game's own choice (host/oot_ocb_hold.h).")
SW(HOS_OCB_NORMAL, kill, bool, "OoT's OptimizeChange background thread runs at lowered host priority", "=1 leaves the OptimizeChange thread at normal priority, as before.")
SW(HOS_OOT_BARRIER_WAIT, kill, bool, "on: three of OoT's parallel-for jobs (f_800998a0, f_800738e0, f_8007e200) wait until a mask word their barrier polls moves, woken by the thread that ORs it (at most 1 ms)", "=0: the game's job barriers sleep 20 us and look again, as before; HOS_AB may flip it.")
SW(HOS_OOT_CHEATS, player, bool, "the Debug tab's tools row (off)", "=1 turns the Debug tab's tools (flight, free camera, teleport, inventory) on whatever the menu's row says.")
SW(HOS_OOT_PROTECT_HEARTS, attempt, bool, "off", "=1 turns heart protection on at start (the host's own, and the menu's when HOS_OOT_CHEATS=1).")
SW(HOS_OOT_TELEPORT_EVENT, diag, string, "Dm_SY_BancChangeGo", "Names the game event the Debug tab's teleport runs, in place of Dm_SY_BancChangeGo.")
SW(HOS_OOT_TELEPORT_STARTER, kill, bool, "the teleport's event is run with its starter", "=0 runs the Debug tab's teleport event without the starter.")
SW(HOS_OOT_TRACE_SAVES, diag, bool, "off", "Logs each save request (reason, mode, caller) and each suppressed transition autosave.")
SW(HOS_OPTIONS_FILE, diag, string, "--user's folder, the launcher's folder, else beside the game", "Names the settings file (hookshot_options.ini) to use, so a scripted run leaves the player's alone.")
SW(HOS_OS_YIELD, kill, bool, "off: nn::os::YieldThread gives up the virtual core only (no SwitchToThread)", "=1: the game's yields give up the processor too, as before; HOS_AB may flip it.")
SW(HOS_OUTPUT_RES, player, string, "the options file's output_res, else 2560x1440 or the screen's size", "Sets the output resolution (WxH) for a run, over the menu's Output resolution row.")
SW(HOS_PAGES_LIMIT, attempt, bool, "off: mapped pages are only counted and logged", "=1 makes AllocateMemoryPages fail past the console's total memory, as on the console.")
SW(HOS_PGO, diag, string, "unset: no counter dumps", "In an RX_PGO=gen build, <file>.reset clears and <file>.dump writes the profile counters; also turns the crash window off.")
SW(HOS_PIN, attempt, string, "off: no affinity by thread name", "Sets host CPU affinity by thread name: <name part>=<hex mask>,... with * for the rest.")
SW(HOS_PIN_BY_CORE, attempt, bool, "off: game threads are not pinned by core number", "=1 runs each game thread on the host's logical core 2 x its guest core number.")
SW(HOS_POLL_SLEEP_NS, attempt, int, "0: off, sleeps last as asked", "Caps guest sleeps of up to 100 us at the given ns.")
SW(HOS_POOL_TRAP, diag, int, "unset: off", "Above 0 traps the resident pool pages that many seconds in, to see who touches them (host/hos_memsplit.c).")
SW(HOS_POOL_TRAP_EVERY, diag, int, "0: once", "With HOS_POOL_TRAP, the trap is set again every that many seconds.")
SW(HOS_POOL_TRAP_FLAGS, diag, string, "24,64,22", "With HOS_POOL_TRAP, the pool flags (hex, comma list) whose pages are trapped.")
SW(HOS_POOL_TRAP_NEW, diag, bool, "off", "=1 traps pools as they are made, without HOS_POOL_TRAP.")
SW(HOS_POOL_TRAP_OUT, diag, string, "pooltrap.txt", "With HOS_POOL_TRAP, the file its report is written to.")
SW(HOS_POOL_TRAP_RANGE, diag, string, "unset: the whole guest space", "With HOS_POOL_TRAP, lo:hi (hex) limits the trap to that range.")
SW(HOS_POOL_TRAP_REPORT, diag, int, "105 s", "With HOS_POOL_TRAP, when the full report is written.")
SW(HOS_POWER_THROTTLING, kill, bool, "Windows power throttling is turned off for the process", "Non-zero leaves Windows' power throttling (EcoQoS, timer resolution) as the OS sets it.")
SW(HOS_PREFAULT, attempt, bool, "off: heap pages fault in as the game touches them", "=1 touches new heap pages when the heap grows, so the game's first touches are not page faults.")
SW(HOS_PRESENT_NOWAIT, hw, bool, "follows the renderer's render thread: on with Threaded rendering/RX_VK_ASYNC, off otherwise", "The game's two present-done event polls are answered 1 at once (1) or read from the GPU (0).")
SW(HOS_PRESENT_POLL, attempt, bool, "off", "=1 has OoT's present poll look at its NVN event between yields instead of sleeping the whole step.")
SW(HOS_PRESENT_TRACE, diag, string, "no trace", "Writes a CSV line for every game present with host-clock times.")
SW(HOS_PRIO, attempt, string, "off: no priority by thread name", "Sets host thread priority by thread name: <name part>=<-2..2>,...")
SW(HOS_PROCESS_PRIORITY, hw, enum, "1: above normal (Windows)", "The process's priority class: 0 normal, 1 above normal, as Windows' levels go.")
SW(HOS_PROFILE, diag, int, "off", "Turns the whole profiling mode on: sampler, traces and timing logs into a folder of their own.")
SW(HOS_PROFILE_DIR, diag, string, "unset: the frame trace goes to logs/hookshot_frames.csv", "The run's profile folder: RX_VK_FRAME_TRACE writes frames.csv there.")
SW(HOS_PROFILE_EVERY, diag, int, "off (HOS_PROFILE=1 sets it to 5)", "Logs the process's busiest threads every <seconds>; also what lets HOS_SAMPLE sample a thread.")
SW(HOS_PROFILE_GATE, diag, string, "off", "<thread>:<lr hex>: the profiler samples only while that thread waits on a light event from that caller.")
SW(HOS_QUEUE_TRACE, diag, bool, "off", "Logs the first 400 message queue puts (thread, queue, value).")
SW(HOS_REALTIME_STEP, player, bool, "the menu's real-time step row", "Overrides the menu's real-time game step row for a run; 0 keeps the shipping whole steps.")
SW(HOS_REALTIME_WINDOW, tune, int, "5", "How many frames (1-5) are averaged for the real-time game step.")
GONE(HOS_RECORD_STUTTERS, "2026-11-11", "use HOS_PROFILE=1, the profiling mode")
SW(HOS_REGION_COMMIT, kill, bool, "off: address regions committed as the game maps their pages", "=1 commits each region whole, as before.")
SW(HOS_REGION_LOG, diag, bool, "off", "Logs the game's address regions mapped, freed and kept, every 30 s at most.")
SW(HOS_RESERVE_CORE, hw, bool, "one core kept for the replay with 8+ logical processors; none on cache-split CPUs (Windows)", "0 reserves no core for the replay; 1 keeps one even on cache-split CPUs.")
SW(HOS_RESERVE_CORE_MASK, tune, string, "unset: HOS_RESERVE_CORE's rule picks the core", "Gives the reserved cores for the replay as a hex mask, over the automatic choice.")
SW(HOS_RESTART_OF, diag, int, "unset: no earlier run to wait for", "The process id of the run that restarted this one: the start waits up to 10 s for it to exit before moving the log.")
SW(HOS_RES_LOG, diag, bool, "off", "Logs the 3D's resolution scale and the game's dynamic-resolution fields every 300 presents.")
SW(HOS_RES_SCALE, player, float, "the menu's Resolution scale", "The fixed-resolution path's 3D scale, over the Insert menu's Resolution row.")
SW(HOS_RT_POOL_MB, tune, int, "the game's pool scaled with the output's pixels: at least 512 MB, 900 MB past 4K", "Sets the size of the game's render-target pool in MB, over the scaled default.")
SW(HOS_RUMBLE_BACKEND, attempt, enum, "auto: the Vibration row's Auto (RenHDrum for a DualSense on a cable, a Switch controller's own HD rumble, the motors otherwise)", "renhdrum: RenHDrum for every controller it can play (a DualSense over Bluetooth, an Xbox One or Series controller's four motors, a Switch controller's packets), for testers; motors: every controller's motors; hd: no RenHDrum at all (host/vibration.h).")
SW(HOS_SAMPLE, diag, string, "off", "Samples the named thread's instruction pointer every millisecond (with HOS_PROFILE_EVERY).")
SW(HOS_SAMPLE_ALL, diag, string, "off (HOS_PROFILE=1 sets it to the profile folder's all.txt)", "Writes every game and renderer thread's stack every 2 ms to the path, while <path>.go exists.")
SW(HOS_SAMPLE_FILE, diag, string, "unset: HOS_SAMPLE logs its most frequent places only", "Writes every HOS_SAMPLE sample's whole stack to the given file.")
SW(HOS_SAMPLE_PACKED, diag, bool, "off: plain sample lines", "The sampler writes each distinct stack once (packed format, read by scripts/samples.py).")
SW(HOS_SAVE_BACKUP, kill, bool, "on: the saves are backed up as the game writes them", "=0 makes no save backups.")
SW(HOS_SAVE_BACKUPS, player, string, "the user's data folder's save-backups", "The folder the save backups go to.")
SW(HOS_SAVE_RESTORE, kill, bool, "on: a game folder with no saves gets the newest backup back at its first start", "=0 restores nothing.")
SW(HOS_SCAN_DT, diag, string, "off", "Writes every guest float between ~0.015 and ~0.04 with its address to <prefix> files, four times.")
GONE(HOS_SCENE_NATIVE, "2026-11-11", "it does nothing")
SW(HOS_SDL_VERSION, kill, enum, "SDL3 when present, else SDL2", "=2 loads SDL2 even when SDL3 is there.")
SW(HOS_SHADER_DUMP, diag, string, "no dump", "Writes each shader stage's code and control section into the named folder for gpu/shadertool.")
SW(HOS_SHADOW_BUCKET, tune, int, "384 (HOS_SHADOW_SLOT_STEP)", "The step of sides a character's shadow map reserves storage in; 0: every texture its own size.")
SW(HOS_SHADOW_STABLE, kill, enum, "the sun's nearest shadow cascade kept steady on Shadow resolution Highest (3072 texels), the game's fit below", "=0 (or false, off, no): the game's fit at every Shadow resolution, as shipped; =1 (or true, on, yes): the steady fit at every Shadow resolution.")
SW(HOS_SHORT_SLEEP_PAUSE, attempt, bool, "off: a short sleep yields until its time", "=1 yields once, then waits on PAUSE until its time.")
SW(HOS_SHORT_SLEEP_POLLERS, hw, int, "a quarter of the logical processors (none where not known)", "Caps how many game threads may yield through a short sleep at once (0: no limit, as before).")
SW(HOS_SHORT_SLEEP_TIMER, hw, bool, "the game's sub-ms sleeps wait on the timer with few logical processors, else yield", "1 puts every sub-millisecond sleep on the timer; 0 makes them all yield, as before.")
SW(HOS_SIZE_TRACE, diag, bool, "off", "Logs who asks for the picture's texture sizes, with a backtrace (first 24).")
SW(HOS_SKIP_ANY_EVENT, kill, bool, "on: every cutscene can be skipped, the opening, the staff credits and the title scene too (host/event_skip.c)", "=0 keeps the game's no-skip setting for those three.")
SW(HOS_SKIP_OPENING, player, bool, "the menu's skip opening row", "Overrides the menu's Skip opening row for a run.")
SW(HOS_SLEEP_LOG, diag, bool, "off", "Logs guest sleeps by caller every 5 s (count, asked, slept), and OoT's present poll sleeps.")
SW(HOS_SLOW_FRAMES, diag, string, "off", "The slow-frame recorder: all threads sampled into a ring, a late frame's samples written to <path>-n.txt.")
SW(HOS_SLOW_FRAMES_EVERY_MS, diag, int, "4", "The slow-frame recorder's sampling period in ms.")
SW(HOS_SLOW_FRAMES_MAX, diag, int, "40", "The most slow frames the recorder writes in a run.")
SW(HOS_SLOW_FRAME_MS, diag, int, "50", "How long a frame must take, in ms, for the slow-frame recorder to write it out.")
SW(HOS_SPIN_ALWAYS, kill, bool, "adaptive: an object whose spins keep missing is spun on 1 time in 32", "Spins before every sleep on every object, without the adaptive back-off.")
SW(HOS_SPIN_OTHER_US, hw, int, "5 us with more logical processors than the short-sleep limit, else HOS_SPIN_US's", "Sets the spin before a wait sleeps on threads other than the frame's serial ones, in us (never above HOS_SPIN_US).")
SW(HOS_SPIN_US, tune, int, "20 us", "Sets the spin before a wait sleeps on the frame's serial threads, in us (0: no spin).")
SW(HOS_STATS_AFTER, diag, int, "unset: the host call statistics come at exit only", "With HOS_HOSTCALL_STATS=1, prints the host call counts and last calls after that many seconds.")
SW(HOS_SWITCH2, kill, bool, "on: a Switch 2 Pro Controller over USB is read by the game (Windows)", "=0 leaves the controller alone, so a bridge program can have it (host/pad_switch2.c).")
SW(HOS_SWITCH2_RUMBLE_TEST, diag, bool, "off", "=1 checks that controller's rumble without hands: a second at rest, a second of rumble, and how far its accelerometer moved in each, in the log.")
SW(HOS_SYNC_REHASH_OLD, diag, bool, "off: the sync-object table's rehash reads each slot's live byte", "=1 reads liveness from each object, as before.")
SW(HOS_SYNC_TABLE_LOCK, kill, bool, "off: lock-free table reads", "Sync object lookups take the table's shared lock, as before.")
SW(HOS_SYNC_TRACE, diag, bool, "off", "Logs nvdrv fences and sync point waits.")
SW(HOS_TEST_ALLOC_REFUSE, diag, string, "off", "Refuses every allocation whose label contains the text (or one huge C++ allocation at the 600th present).")
SW(HOS_TEXELS_HOLD_CORE, kill, bool, "off: a thread writing or reading a texture gives its virtual core up meanwhile", "=1 keeps the core, as before.")
SW(HOS_TEXTS, kill, bool, "on: reworded texts served from the game folder's texts", "=0: the game's own texts, not the ones reworded for a PC.")
SW(HOS_TEXT_SIZE, player, int, "the menu's Text size row", "The dialogue text size choice, over the Insert menu's Text size option.")
SW(HOS_TEXT_SPEED, player, int, "the menu's Text speed row (0: the game's)", "Text speed 0-3 (the game's, 2x, 4x, instant) over the options file.")
SW(HOS_TEX_COMPACT_MS, tune, string, "1000: the game's texture manager asks for a compaction round of its texture heap at most once a second", "At least that many milliseconds between two rounds; 0: at every frame none runs, as the game has it; off: never.")
SW(HOS_THP, kill, bool, "transparent huge pages are off in the guest window (MADV_NOHUGEPAGE)", "=1 allows transparent huge pages in the guest window, as before.")
SW(HOS_THREAD_OF_CACHE, attempt, bool, "off: a guest thread's host thread is found by a scan", "=1 keeps a small per-thread cache of the answers.")
SW(HOS_THREAD_TIMES, diag, int, "off (HOS_PROFILE=1 sets it to HOS_PROFILE_EVERY's)", "Logs every <seconds> the threads that used over 5 % of a core, by name.")
SW(HOS_TICK_CONVERT_192, kill, bool, "tick conversions use the counter's own 31.25 MHz", "=1 converts ticks at the Switch 1's 19.2 MHz, as before (spans 1.63x too long).")
SW(HOS_TICK_LOG, diag, bool, "off", "Logs who reads the clock, by caller, every 5 s.")
SW(HOS_TLS_TRACE, diag, bool, "off", "Logs thread-local storage setup, as HOS_TRACE does, without the rest of the trace.")
SW(HOS_TRACE, diag, bool, "off", "Logs every HLE call that uses HOS_TRACE_CALL.")
SW(HOS_TRACY_GAME, diag, enum, "on in a HOOKSHOT_TRACY build (no other build has the zones): the lifted game code's zones are recorded", "=0 leaves the listed game functions' zones and their indirect calls' out of a Tracy capture; funcs or calls: that kind alone.")
SW(HOS_VCORES, kill, bool, "on: guest threads are scheduled on virtual cores", "=0 turns the virtual cores off.")
SW(HOS_VCORE_ESCAPE_EQ_US, tune, int, "2000000 us (2 s)", "Sets how long a waiter waits for a holder of equal priority before it runs without a core.")
SW(HOS_VCORE_ESCAPE_US, tune, int, "2000000 us (2 s)", "Sets how long a better-priority waiter waits for a core before it runs without one.")
SW(HOS_VCORE_LOG, diag, bool, "off", "With the vcores: line, logs each thread that waited for a core: its waits and time, priority and core mask.")
SW(HOS_VCORE_LOG_MS, diag, int, "50 ms", "Sets how long a wait for a virtual core must last to be logged with its cause (0: none).")
SW(HOS_VCORE_REPLAY_BOOST, tune, int, "2 priority steps", "A thread back from the replay takes a core ahead of threads up to that many steps better than it; 0: as before.")
SW(HOS_VCORE_SLICE_US, tune, int, "2000 us", "Sets the wait after which a holder as good as the waiter is asked to give its core up (a time slice).")
SW(HOS_VCORE_SPIN_US, tune, int, "0: none", "How long a thread spins for a virtual core before it waits.")
SW(HOS_VCORE_STARVE_US, tune, int, "1000000 us (1 s)", "Sets the wait after which a waiter goes before every other at the next core release (0: never).")
SW(HOS_VCORE_WAITS, diag, bool, "off", "Logs who waits for a core, by thread name, with the vcores: line.")
SW(HOS_VC_PRIO, attempt, string, "unset: the game's own priorities", "name=priority list: those threads are scheduled for a virtual core at that priority.")
SW(HOS_VIDEO_ACQUIRE_TRIES, kill, bool, "off: the wait for a picture is ~100 ms by the clock", "A movie waits for a picture by 50 sleeps of 2 ms (~250 ms), as before.")
SW(HOS_VIDEO_INPUT_LIMIT, tune, int, "16", "How many submissions a video decoder holds before refusing the next; 0: no limit, as before.")
SW(HOS_VIDEO_LOG, diag, bool, "off", "Logs video decoder submissions and acquisitions and the time between a movie's pictures.")
SW(HOS_VIDEO_NO_CATCHUP, kill, bool, "off: pictures behind the sound are skipped", "A movie never skips pictures that are behind its sound.")
SW(HOS_VIDEO_NO_HOLD, kill, bool, "off: a movie picture ahead of the movie's clock is held back above 60 fps", "=1 hands every picture out at once, as before.")
SW(HOS_VIDEO_RGBA, kill, bool, "off: NV12/YUV420 frames are queued and converted to RGBA lazily", "Forces every decoded movie frame to be converted to RGBA at once, the older path.")
SW(HOS_VI_DOUBLE, kill, bool, "off: an acquire waits only for the frame whose showing frees its texture", "The acquire waits one interval after the last present, the older two-texture behaviour.")
SW(HOS_VOICE_OPTION_FOLLOW, kill, bool, "on: the Voice Language read from option.sav is applied", "=0: the Voice Language option is applied only when the game lists it as written, as shipped.")
SW(HOS_VSYNC_YIELD, kill, bool, "off: the vsync ticker waits on a high-resolution timer (Windows)", "=1 makes it wait by yielding in a loop under a millisecond, as before.")
SW(HOS_WAIT_LOG, diag, bool, "off", "Every 5 s, event waits by guest caller and thread: count, total and longest.")
SW(HOS_WAIT_WHO, diag, string, "off", "For the named thread, logs the events it waits on and who signals them.")
SW(HOS_WAIT_WHO_LR, diag, string, "every caller", "Narrows HOS_WAIT_WHO to waits from one guest caller (hex return address).")
SW(HOS_WAKE_LAT, diag, bool, "off", "Every 5 s, per thread: how event and queue waits were met and the signal-to-running latency.")
SW(HOS_WATCH, diag, string, "off", "Sets CPU data breakpoints on up to 4 guest addresses listed in the named file, when it exists.")
SW(HOS_WEB_SPIN_SLEEP, kill, bool, "web build: sleeps use a timed wait, then a short spin", "=1 spins the whole sleep, as before.")
SW(HOS_WHEEL_HOLD_MS, tune, int, "250 ms (50 to 2000)", "How long the item wheel's button is held before the wheel opens.")
SW(HOS_WHEEL_SOUND_GAIN, tune, float, "0.7", "The item wheel's tick sound's volume.")
SW(HOS_WHEEL_TAP_FRAMES, tune, int, "1 (1 to 8)", "For how many input reads a tap on the wheel's button is held.")
SW(HOS_WHEEL_TRACE, diag, bool, "off", "Logs the item wheel's opening and how long it takes to be drawn.")
SW(HOS_WIDE_KEEP, diag, string, "the renderer's keep mask (the Ultrawide menus row)", "A hex mask forced over the renderer's choice of which menus stay 16:9 on a wide screen.")
SW(HOS_WIDE_MAX_PX, tune, float, "5120 x 2160 pixels (11059200)", "Sets the most pixels a widescreen picture may take.")
SW(HOS_WIDE_UI, player, bool, "the Insert menu's HUD layout row", "Stands over the menu's HUD layout row: 0 turns the HUD's widescreen moves off; the row is then held and says so.")
SW(HOS_WIDE_UI_LOG, diag, int, "0: no log", "Logs the first n changes of the widescreen HUD plan, each root layout and the plan's time.")
SW(HOS_WINDOW_NOACTIVATE, diag, bool, "off: the window opens in front", "=1 opens the window behind the one in front, so test runs do not take the keyboard.")
SW(HOS_WINDOW_SIZE, tune, string, "1280x720", "Sets the window's client size as WxH (each at least 64).")
SW(HOS_WINDOW_TITLE, tune, string, "'Hookshot'", "The window's title on Linux (SDL).")
SW(HOS_WM_CLASS, tune, string, "HOS_APP_ID", "The window's WM class / app id on Linux (SDL).")
SW(HOS_WS_FLOOR_MB, hw, int, "Windows: a soft working-set minimum of a quarter of the RAM, at most 4096 MB: Windows keeps that much of the game in RAM before it trims below it (host/ws_floor.h)", "<MB>: that minimum instead (at most half the RAM); 0 (or off, no, false): Windows' own minimum, as before, so memory pressure can trim the game to a fraction of what its frames touch.")
SW(HOS_XINPUT, attempt, bool, "XInput polled only while SDL has no controller open", "Polls XInput as well as SDL even when SDL has controllers open.")
SW(HOS_ZERO_ALL_PAGES, kill, bool, "above 4 GB only pages not already in use are zeroed", "=1 zeroes the whole range of every page allocation, as before.")
