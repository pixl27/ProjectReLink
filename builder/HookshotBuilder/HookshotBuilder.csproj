<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HookshotBuilder</AssemblyName>
    <RootNamespace>HookshotBuilder</RootNamespace>
    <Version>5.0.1</Version>
    <InformationalVersion>$(Version)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Description>Red Tunic portable launcher and local game setup</Description>
    <Product>Red Tunic</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AssemblyTitle>Red Tunic</AssemblyTitle>
    <ApplicationIcon>../../assets/red-tunic.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Needs nothing installed: dotnet publish -c Release. A folder (the app and .NET's own signed files), not one compressed exe:
       antivirus programs took the self-extracting single file for a trojan and removed it -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- Inter (SIL Open Font License, Fonts/Inter-LICENSE.txt) and the hookshot, inside the app -->
  <ItemGroup>
    <Resource Include="Fonts\*.ttf" />
    <Resource Include="../../assets/red-tunic.ico" Link="Images/red-tunic.ico" />
    <Resource Include="../../assets/red-tunic.png" Link="Images/hookshot.png" />
    <None Include="Fonts\Inter-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
