# Review and copy this file outside the source tree before editing it.
# It contains no title data, paths, input script, save, cache, or credentials.
RELINK_NO_UPDATE_CHECK=1
RX_BACKEND=vulkan

# BC-250 RADV DirectMesh and bounded sparse guest-memory profile.
RADV_BC250_TASK_PERSIST=1
RX_VK_PRECOMPILE=0
RX_VK_IMPORT_CHUNK_MB=2
RX_VK_SPARSE_GUEST=1
RX_VK_TEX_MAX_MB=32
RX_VK_VRAM_MB=768
RX_VK_EVICT_MIN_UNUSED=30
RX_VK_DEAD_SWEEP_FAST=1
RX_VK_DROP_DEAD_IMPORTS=1

# Window and controller defaults. The launcher owns resolution scale,
# framerate, fullscreen, query correctness and replay-worker defaults.
HOS_REGION_LOG=1
HOS_WINDOW_SIZE=1280x720
HOS_INPUT_EXCLUSIVE=1
