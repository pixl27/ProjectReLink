<Window x:Class="ReLink.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project ReLink" Width="1120" Height="700" WindowStyle="None" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Shell}" Foreground="{DynamicResource Bone}"
        FontFamily="{DynamicResource Text}" FontSize="14.5" Icon="app.ico" AllowDrop="True" UseLayoutRounding="True">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <!-- The cartridge: the grey shell and its grooves; on the left the dark side (where to go, Play), on the right the cream label
       (one page at a time: Home, the options, the install and its steps, a problem) -->
  <Grid x:Name="Root" ClipToBounds="True" Background="{DynamicResource Shell}">
    <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition/></Grid.RowDefinitions>

    <!-- the grooves along the top, and the window's own buttons -->
    <Rectangle Height="7" Margin="260,0,260,0" VerticalAlignment="Center" RadiusX="2" RadiusY="2">
      <Rectangle.Fill>
        <DrawingBrush TileMode="Tile" Viewport="0,0,9,7" ViewportUnits="Absolute" Viewbox="0,0,9,7" ViewboxUnits="Absolute">
          <DrawingBrush.Drawing>
            <GeometryDrawing Brush="{DynamicResource Groove}"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,3,7"/></GeometryDrawing.Geometry></GeometryDrawing>
          </DrawingBrush.Drawing>
        </DrawingBrush>
      </Rectangle.Fill>
    </Rectangle>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0">
      <Button x:Name="MinButton" Style="{StaticResource Chrome}" Click="Minimize">
        <Path Data="M0,0 L11,0" Stroke="{DynamicResource Bone}" StrokeThickness="1.6" Margin="0,7,0,0"/>
      </Button>
      <Button x:Name="CloseButton" Style="{StaticResource Chrome}" Click="CloseWindow">
        <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{DynamicResource Bone}" StrokeThickness="1.6"/>
      </Button>
    </StackPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="214"/><ColumnDefinition/></Grid.ColumnDefinitions>

      <!-- the side, the same on every page: where to go, then the game's state card (Sidebar.cs) and the small links. A thing is
           said in one place only: the version and the update in the card, the settings on Home's cards, Play in the sky on Home
           and in the card elsewhere -->
      <Border x:Name="LeftColumn" Background="{DynamicResource Side}" CornerRadius="12" Margin="12,0,0,12" Padding="12,16,12,10">
        <DockPanel LastChildFill="False">
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Project ReLink" FontWeight="ExtraBold" FontSize="19" Foreground="{DynamicResource SideText}" Margin="6,0,0,0"/>
            <StackPanel x:Name="NavPanel" Margin="0,18,0,0">
              <RadioButton x:Name="NavHome" Style="{StaticResource Nav}" GroupName="Nav" IsChecked="True" Checked="NavChanged" Tag="&#xE80F;" BorderBrush="{DynamicResource SideText}"/>
              <RadioButton x:Name="NavOptions" Style="{StaticResource Nav}" GroupName="Nav" Checked="NavChanged" Tag="&#xE9E9;" BorderBrush="{DynamicResource Red}"/>
              <RadioButton x:Name="NavMods" Style="{StaticResource Nav}" GroupName="Nav" Checked="NavChanged" Tag="&#xEA86;" BorderBrush="{DynamicResource Green}">
                <DockPanel Width="118" LastChildFill="False">
                  <TextBlock x:Name="NavModsText" Text="Mods"/>
                  <Border x:Name="ModsBadge" DockPanel.Dock="Right" Background="#E0873A" CornerRadius="9" MinWidth="18" Height="18" Padding="5,0" Visibility="Collapsed">
                    <TextBlock Text="!" FontSize="12" FontWeight="ExtraBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                </DockPanel>
              </RadioButton>
            </StackPanel>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom">
            <!-- the state card: what (a version, the install, the update), its state in a pill, a line when there is something to
                 say, the way from the copy to Play while it is built, and the one button that matters here -->
            <Border x:Name="StatusCard" Background="{DynamicResource StatusCard}" CornerRadius="10" Padding="12,11,12,12">
              <StackPanel>
                <DockPanel LastChildFill="True">
                  <Border x:Name="StatePill" DockPanel.Dock="Right" CornerRadius="9" Padding="8,2,8,3" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="StatePillText" FontSize="11.5" FontWeight="Bold"/>
                  </Border>
                  <TextBlock x:Name="CardTitle" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource SideText}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                </DockPanel>
                <TextBlock x:Name="MainNote" FontSize="12.5" Foreground="{DynamicResource SideSoft}" TextWrapping="Wrap" Margin="0,5,0,0" Visibility="Collapsed"/>
                <StackPanel x:Name="StepList" Margin="0,8,0,0" Visibility="Collapsed"/>
                <Button x:Name="UpdateLink" Style="{StaticResource GoldButton}" Margin="0,10,0,0" Visibility="Collapsed" Click="UpdateClick"/>
                <Button x:Name="MainButton" Style="{StaticResource Play}" Height="54" Margin="0,10,0,0" Click="MainClick">
                  <TextBlock x:Name="MainButtonText" FontWeight="ExtraBold" FontSize="20" Foreground="White"/>
                </Button>
              </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button x:Name="FolderLink" Style="{StaticResource SideIcon}" Content="&#xE838;" Click="OpenGameFolder"/>
              <Button x:Name="HelpLink" Style="{StaticResource SideIcon}" Content="&#xE897;" Click="OpenHelp"/>
              <Button x:Name="DiscordLink" Style="{StaticResource SideIcon}" Content="&#xE8BD;" Click="OpenDiscord"/>
              <Button x:Name="ReportLink" Style="{StaticResource SideIcon}" Content="&#xEBE8;" Click="OpenReport"/>
            </StackPanel>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- the label: one page at a time -->
      <Border x:Name="Tablet" Grid.Column="1" Background="{DynamicResource Label}" CornerRadius="12" Margin="10,0,12,12">
        <Grid Margin="20,16,20,14">

          <!-- Home: the sky over Hyrule at the player's hour, the staff with what the game needs, what Play will do -->
          <Grid x:Name="HeroView" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid x:Name="HeroSky" Height="372">
              <Grid.Clip><RectangleGeometry x:Name="HeroClip" Rect="0,0,844,372" RadiusX="10" RadiusY="10"/></Grid.Clip>
              <Canvas x:Name="Sky" Width="844" Height="372" HorizontalAlignment="Left" VerticalAlignment="Top"/>
              <StackPanel Margin="24,20,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                <TextBlock Text="Ocarina of Time" FontWeight="ExtraBold" FontSize="34" Foreground="{StaticResource StaffBone}"/>
                <TextBlock x:Name="HeroSub" FontSize="13.5" Foreground="{StaticResource StaffBone}" Opacity="0.85" Margin="2,2,0,0"/>
              </StackPanel>
              <Canvas x:Name="StaffCanvas" Width="424" Height="176" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="26,176,0,0"/>
              <!-- Play, where the eye goes (what it will show: the cards under the sky) -->
              <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,18">
                <Button x:Name="HeroPlay" Style="{StaticResource Play}" Width="210" Height="58" HorizontalAlignment="Right" Click="MainClick">
                  <TextBlock x:Name="HeroPlayText" FontWeight="ExtraBold" FontSize="22" Foreground="White"/>
                </Button>
              </StackPanel>
            </Grid>
            <Grid Grid.Row="2" Margin="0,12,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Border x:Name="LooksCard" BorderBrush="{DynamicResource Red}" BorderThickness="0,4,0,0" Background="{DynamicResource Card}" CornerRadius="10" Padding="14,10,14,10" Cursor="Hand" MouseLeftButtonDown="LooksClick">
                <DockPanel LastChildFill="False">
                  <TextBlock DockPanel.Dock="Bottom" x:Name="LooksMore" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource Red}" Margin="0,4,0,0"/>
                  <StackPanel DockPanel.Dock="Top">
                    <TextBlock x:Name="LooksHead" FontSize="12.5" Foreground="{DynamicResource BoneSoft}"/>
                    <TextBlock x:Name="LooksText" FontSize="14.5" FontWeight="Bold" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="LooksSub" FontSize="12.5" Foreground="{DynamicResource BoneSoft}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                  </StackPanel>
                </DockPanel>
              </Border>
              <Border x:Name="MovesCard" Grid.Column="2" BorderBrush="{DynamicResource Yellow}" BorderThickness="0,4,0,0" Background="{DynamicResource Card}" CornerRadius="10" Padding="14,10,14,10" Cursor="Hand" MouseLeftButtonDown="MovesClick">
                <DockPanel LastChildFill="False">
                  <TextBlock DockPanel.Dock="Bottom" x:Name="MovesMore" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource Yellow}" Margin="0,4,0,0"/>
                  <StackPanel DockPanel.Dock="Top">
                    <TextBlock x:Name="MovesHead" FontSize="12.5" Foreground="{DynamicResource BoneSoft}"/>
                    <TextBlock x:Name="MovesText" FontSize="14.5" FontWeight="Bold" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="MovesSub" FontSize="12.5" Foreground="{DynamicResource BoneSoft}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                  </StackPanel>
                </DockPanel>
              </Border>
              <Border x:Name="ModsCard" Grid.Column="4" BorderBrush="{DynamicResource Green}" BorderThickness="0,4,0,0" Background="{DynamicResource Card}" CornerRadius="10" Padding="14,10,14,10" Cursor="Hand" MouseLeftButtonDown="ModsCardClick">
                <DockPanel LastChildFill="False">
                  <TextBlock DockPanel.Dock="Bottom" x:Name="ModsMore" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource Green}" Margin="0,4,0,0"/>
                  <StackPanel DockPanel.Dock="Top">
                    <TextBlock x:Name="ModsHead" FontSize="12.5" Foreground="{DynamicResource BoneSoft}"/>
                    <TextBlock x:Name="ModsCardText" FontSize="14.5" FontWeight="Bold" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ModsSub" FontSize="12.5" Foreground="{DynamicResource BoneSoft}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                  </StackPanel>
                </DockPanel>
              </Border>
              <Border x:Name="NewsCard" Grid.Column="6" BorderBrush="{DynamicResource Blue}" BorderThickness="0,4,0,0" Background="{DynamicResource Card}" CornerRadius="10" Padding="14,10,14,10" Cursor="Hand" MouseLeftButtonDown="NewsCardClick">
                <DockPanel LastChildFill="False">
                  <TextBlock DockPanel.Dock="Bottom" x:Name="NewsMore" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource Blue}" Margin="0,4,0,0"/>
                  <StackPanel DockPanel.Dock="Top">
                    <TextBlock x:Name="NewsHead" FontSize="12.5" Foreground="{DynamicResource BoneSoft}"/>
                    <TextBlock x:Name="NewsText" FontSize="14.5" FontWeight="Bold" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="NewsSub" FontSize="12.5" Foreground="{DynamicResource BoneSoft}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                  </StackPanel>
                </DockPanel>
              </Border>
            </Grid>
            <TextBlock x:Name="HeroFoot" Grid.Row="4" FontSize="12.5" Foreground="{DynamicResource BoneFaint}" Margin="2,10,0,0"/>
          </Grid>

          <!-- install: the player's copy, and where the game goes -->
          <Grid x:Name="InstallView" Visibility="Collapsed">
            <Grid.Resources>
              <StaticResource x:Key="Accent" ResourceKey="Blue"/><StaticResource x:Key="AccentTint" ResourceKey="BlueTint"/><StaticResource x:Key="AccentEdge" ResourceKey="BlueEdge"/>
            </Grid.Resources>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Style="{StaticResource Strip}" Background="{DynamicResource Blue}"><TextBlock x:Name="InstallTitle" Style="{StaticResource ViewTitle}"/></Border>
            <TextBlock x:Name="InstallSub" Grid.Row="1" Style="{StaticResource Body}" Margin="2,10,0,0"/>
            <TextBlock x:Name="CopyHead" Grid.Row="2" Style="{StaticResource Section}" Margin="2,16,0,4"/>
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel x:Name="DumpList"/>
            </ScrollViewer>
            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="2,10,0,0">
              <Button x:Name="BrowseNupLink" Style="{StaticResource Link}" Margin="0,0,22,0" Click="BrowseNup"/>
              <Button x:Name="BrowseFoldersLink" Style="{StaticResource Link}" Click="BrowseFolders"/>
            </StackPanel>
            <TextBlock x:Name="OutHead" Grid.Row="5" Style="{StaticResource Section}" Margin="2,16,0,4"/>
            <Grid Grid.Row="6" Margin="2,0,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="OutPathText" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
              <Button x:Name="OutChange" Grid.Column="1" Style="{StaticResource Link}" Margin="16,0,0,0" Click="BrowseOut"/>
            </Grid>
            <TextBlock x:Name="SpaceText" Grid.Row="7" Style="{StaticResource RowHint}" Margin="2,6,0,0"/>
            <TextBlock x:Name="ToolsNote" Grid.Row="8" Style="{StaticResource RowHint}" Foreground="{DynamicResource Warn}" Margin="2,8,0,0" Visibility="Collapsed"/>
          </Grid>

          <!-- the install at work: how far it is, its steps one a row, the one at work marked -->
          <Grid x:Name="BuildView" Visibility="Collapsed">
            <Grid.Resources>
              <StaticResource x:Key="Accent" ResourceKey="Green"/><StaticResource x:Key="AccentTint" ResourceKey="GreenTint"/><StaticResource x:Key="AccentEdge" ResourceKey="GreenEdge"/>
            </Grid.Resources>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Style="{StaticResource Strip}" Background="{DynamicResource Green}"><TextBlock x:Name="BuildTitle" Style="{StaticResource ViewTitle}"/></Border>
            <TextBlock x:Name="BuildSub" Grid.Row="1" Style="{StaticResource Body}" Foreground="{DynamicResource BoneFaint}" Margin="2,8,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
            <Grid x:Name="ProgressBlock" Grid.Row="2" Margin="2,8,0,10" Visibility="Collapsed">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <TextBlock x:Name="PercentText" Text="0 %" FontWeight="ExtraBold" FontSize="46" VerticalAlignment="Center"/>
              <TextBlock x:Name="BuildNote" Grid.Column="1" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="22,0,0,0"/>
            </Grid>
            <StackPanel x:Name="StageList" Grid.Row="3"/>
            <TextBox x:Name="Log" Grid.Row="3" Visibility="Collapsed" IsReadOnly="True" FontFamily="{StaticResource Mono}" FontSize="11.5"
                     Background="{DynamicResource Card}" Foreground="{DynamicResource HelpInk}" BorderThickness="0" Padding="10" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="2,12,0,0">
              <Button x:Name="LogLink" Style="{StaticResource Link}" Margin="0,0,22,0" Click="LogToggled"/>
              <Button x:Name="CancelLink" Style="{StaticResource Link}" Foreground="{DynamicResource BoneSoft}" Click="CancelBuild"/>
            </StackPanel>
          </Grid>


          <!-- something went wrong -->
          <Grid x:Name="ProblemView" Visibility="Collapsed">
            <Grid.Resources>
              <StaticResource x:Key="Accent" ResourceKey="Red"/><StaticResource x:Key="AccentTint" ResourceKey="RedTint"/><StaticResource x:Key="AccentEdge" ResourceKey="RedEdge"/>
            </Grid.Resources>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Style="{StaticResource Strip}" Background="{DynamicResource Red}"><TextBlock x:Name="ProblemTitle" Style="{StaticResource ViewTitle}"/></Border>
            <TextBlock x:Name="ProblemSub" Grid.Row="1" Style="{StaticResource Body}" Margin="2,10,0,0"/>
            <TextBlock x:Name="ProblemHead" Grid.Row="2" Style="{StaticResource Section}" Margin="2,16,0,4"/>
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="2,0,0,0">
                <TextBlock x:Name="ProblemText" Style="{StaticResource Body}" Foreground="{DynamicResource Bone}"/>
                <StackPanel x:Name="ProblemSteps" Margin="0,10,0,0"/>
              </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="2,14,0,0">
              <Button x:Name="BackLink" Style="{StaticResource Link}" Foreground="{DynamicResource BoneSoft}" Margin="0,0,22,0" Click="Back"/>
              <Button x:Name="RepairLink" Style="{StaticResource Link}" Margin="0,0,22,0" Click="Repair"/>
              <Button x:Name="DetailsLink" Style="{StaticResource Link}" Margin="0,0,22,0" Click="ProblemShowDetails"/>
              <Button x:Name="CopyLink" Style="{StaticResource Link}" Click="CopyForReport"/>
            </StackPanel>
          </Grid>

          <!-- the options: the in-game menu's layout, a page a colour (Home.cs makes the rows) -->
          <!-- Mods: what is in the game folder's mods, on or off -->
          <Grid x:Name="ModsView" Visibility="Collapsed">
            <Grid.Resources>
              <StaticResource x:Key="Accent" ResourceKey="Green"/><StaticResource x:Key="AccentTint" ResourceKey="GreenTint"/><StaticResource x:Key="AccentEdge" ResourceKey="GreenEdge"/>
            </Grid.Resources>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Style="{StaticResource Strip}" Background="{DynamicResource Green}" HorizontalAlignment="Left">
              <TextBlock x:Name="ModsTitle" FontWeight="Bold" FontSize="16" Foreground="White"/>
            </Border>
            <TextBlock x:Name="ModsIntro" Grid.Row="1" Style="{StaticResource Body}" Margin="2,10,0,8"/>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="ModsList"/>
            </ScrollViewer>
            <WrapPanel Grid.Row="3" Margin="2,10,0,0">
              <Button x:Name="ModsOpenFolder" Style="{StaticResource Link}" Foreground="{DynamicResource Green}" Margin="0,0,22,0" Click="OpenModsFolder"/>
              <Button x:Name="ModsRebuild" Style="{StaticResource Link}" Foreground="{DynamicResource Green}" Visibility="Collapsed" Click="RebuildClick"/>
            </WrapPanel>
          </Grid>

          <Grid x:Name="HomeView" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <UniformGrid Rows="1" Columns="4" Height="42" Margin="-8,-4,-8,0">
              <RadioButton x:Name="TabDisplay" Style="{StaticResource Tab}" Background="{DynamicResource Red}" GroupName="Tabs" IsChecked="True" Checked="TabChanged"/>
              <RadioButton x:Name="TabSmooth" Style="{StaticResource Tab}" Background="{DynamicResource Yellow}" Foreground="{StaticResource OnYellow}" GroupName="Tabs" Checked="TabChanged"/>
              <RadioButton x:Name="TabGame" Style="{StaticResource Tab}" Background="{DynamicResource Green}" GroupName="Tabs" Checked="TabChanged"/>
              <RadioButton x:Name="TabControls" Style="{StaticResource Tab}" Background="{DynamicResource Blue}" GroupName="Tabs" Checked="TabChanged"/>
            </UniformGrid>
            <Grid Grid.Row="1" Margin="0,8,0,0">
              <ScrollViewer x:Name="PageDisplay" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Resources><StaticResource x:Key="Accent" ResourceKey="Red"/><StaticResource x:Key="AccentTint" ResourceKey="RedTint"/><StaticResource x:Key="AccentEdge" ResourceKey="RedEdge"/></ScrollViewer.Resources>
                <StackPanel x:Name="RowsDisplay" Margin="0,0,10,0"/>
              </ScrollViewer>
              <ScrollViewer x:Name="PageSmooth" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <ScrollViewer.Resources><StaticResource x:Key="AccentOn" ResourceKey="OnYellow"/><StaticResource x:Key="Accent" ResourceKey="Yellow"/><StaticResource x:Key="AccentTint" ResourceKey="YellowTint"/><StaticResource x:Key="AccentEdge" ResourceKey="YellowEdge"/></ScrollViewer.Resources>
                <StackPanel x:Name="RowsSmooth" Margin="0,0,10,0"/>
              </ScrollViewer>
              <ScrollViewer x:Name="PageGame" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <ScrollViewer.Resources><StaticResource x:Key="Accent" ResourceKey="Green"/><StaticResource x:Key="AccentTint" ResourceKey="GreenTint"/><StaticResource x:Key="AccentEdge" ResourceKey="GreenEdge"/></ScrollViewer.Resources>
                <StackPanel x:Name="RowsGame" Margin="0,0,10,0"/>
              </ScrollViewer>
              <ScrollViewer x:Name="PageControls" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <ScrollViewer.Resources><StaticResource x:Key="Accent" ResourceKey="Blue"/><StaticResource x:Key="AccentTint" ResourceKey="BlueTint"/><StaticResource x:Key="AccentEdge" ResourceKey="BlueEdge"/></ScrollViewer.Resources>
                <StackPanel x:Name="RowsControls" Margin="0,0,10,0"/>
              </ScrollViewer>
            </Grid>
            <!-- what the selected row does: in a box of its own under the rows, as the in-game menu has it (the rows keep one height) -->
            <Border x:Name="OptionsHelp" Grid.Row="2" BorderThickness="3,0,0,0" BorderBrush="{DynamicResource Red}" Padding="12,2,8,2" Margin="8,10,8,0" Height="62">
              <TextBlock x:Name="OptionsHelpText" FontSize="13" LineHeight="18" Foreground="{DynamicResource HelpInk}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="HomeFoot" Grid.Row="3" Style="{StaticResource RowHint}" Foreground="{DynamicResource BoneFaint}" Margin="12,8,0,0"/>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <!-- while the game runs: the cartridge is in, a small label says so -->
    <Grid x:Name="PlayingOverlay" Grid.Row="1" Background="{DynamicResource Shell}" Visibility="Collapsed">
      <Border Background="{DynamicResource Label}" CornerRadius="12" Padding="40,30" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="620">
        <StackPanel>
          <Border Style="{StaticResource Strip}" Background="{DynamicResource Green}" HorizontalAlignment="Center">
            <TextBlock x:Name="PlayingTitle" Style="{StaticResource ViewTitle}" FontSize="24"/>
          </Border>
          <TextBlock x:Name="PlayingHint" Style="{StaticResource Body}" TextAlignment="Center" Margin="0,14,0,0"/>
          <Button x:Name="RestoreNow" Style="{StaticResource Link}" Foreground="{DynamicResource Green}" HorizontalAlignment="Center" Margin="0,14,0,0" Visibility="Collapsed" Click="RestoreNowClick"/>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
