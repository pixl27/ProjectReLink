<Application x:Class="ReLink.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml" ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <!-- The tablet is forest stone: its colours never change. The sky behind it follows the player's clock (MainWindow.xaml.cs). -->
    <Color x:Key="CStone">#13231C</Color>
    <Color x:Key="CGold">#C9A24B</Color>
    <Color x:Key="CTunic">#3E8E4B</Color>
    <SolidColorBrush x:Key="Bone" Color="#EFE6D0"/>
    <SolidColorBrush x:Key="BoneSoft" Color="#BDB79F"/>
    <SolidColorBrush x:Key="BoneFaint" Color="#8E907B"/>
    <SolidColorBrush x:Key="Gold" Color="{StaticResource CGold}"/>
    <SolidColorBrush x:Key="Tunic" Color="{StaticResource CTunic}"/>
    <SolidColorBrush x:Key="Rule" Color="#22EFE6D0"/>
    <SolidColorBrush x:Key="Warn" Color="#D9825B"/>
    <FontFamily x:Key="Display">Palatino Linotype, Book Antiqua, Georgia</FontFamily>
    <FontFamily x:Key="Text">Candara, Segoe UI</FontFamily>

    <FontFamily x:Key="Mono">Cascadia Mono, Consolas</FontFamily>

    <!-- (no implicit TextBlock style: one in the application's resources reaches inside control templates and would override
         the colour and face a tab or a choice gives its own words. The window sets the face and the colour, and they inherit) -->
    <Style x:Key="ViewTitle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Display}"/>
      <Setter Property="FontSize" Value="27"/>
      <Setter Property="Foreground" Value="{StaticResource Bone}"/>
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Text}"/>
      <Setter Property="FontSize" Value="14.5"/>
      <Setter Property="LineHeight" Value="21"/>
      <Setter Property="Foreground" Value="{StaticResource BoneSoft}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Section" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Display}"/>
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="Foreground" Value="{StaticResource Gold}"/>
      <Setter Property="Margin" Value="0,18,0,6"/>
    </Style>

    <!-- A settings row: label and hint on the left, its control on the right, a hairline under it -->
    <Style x:Key="Row" TargetType="Border">
      <Setter Property="BorderBrush" Value="{StaticResource Rule}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="Padding" Value="0,11,0,11"/>
    </Style>
    <Style x:Key="RowLabel" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Text}"/>
      <Setter Property="Foreground" Value="{StaticResource Bone}"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="RowHint" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Text}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="LineHeight" Value="18"/>
      <Setter Property="Foreground" Value="{StaticResource BoneFaint}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,3,0,0"/>
    </Style>

    <Style x:Key="FocusRing">
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate>
            <Rectangle Margin="-3" Stroke="{StaticResource Gold}" StrokeThickness="1" StrokeDashArray="2 2" SnapsToDevicePixels="True"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A page of the tablet: its name, a gold line under the open one -->
    <Style x:Key="Tab" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{StaticResource BoneFaint}"/>
      <Setter Property="FontFamily" Value="{StaticResource Display}"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="Margin" Value="0,0,30,0"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid Background="Transparent">
              <ContentPresenter Margin="0,6,0,10" TextElement.Foreground="{TemplateBinding Foreground}"/>
              <Rectangle x:Name="line" Height="2" VerticalAlignment="Bottom" Fill="{StaticResource Gold}" Opacity="0"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource BoneSoft}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Bone}"/>
                <Setter TargetName="line" Property="Opacity" Value="1"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- One choice among several: plain words, the chosen one underlined in gold (no pills) -->
    <Style x:Key="Choice" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{StaticResource BoneFaint}"/>
      <Setter Property="FontFamily" Value="{StaticResource Text}"/>
      <Setter Property="FontSize" Value="14.5"/>
      <Setter Property="Margin" Value="0,0,20,2"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid Background="Transparent">
              <ContentPresenter Margin="0,3,0,6" TextElement.Foreground="{TemplateBinding Foreground}"/>
              <Rectangle x:Name="line" Height="1.5" VerticalAlignment="Bottom" Fill="{StaticResource Gold}" Opacity="0"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource BoneSoft}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Bone}"/>
                <Setter TargetName="line" Property="Opacity" Value="1"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- One of the player's game files: a gold bar at its left when it is the chosen one -->
    <Style x:Key="FileRow" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{StaticResource Bone}"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" Background="Transparent" BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1" Padding="14,10,4,10">
              <Grid>
                <Rectangle x:Name="bar" Width="3" HorizontalAlignment="Left" Margin="-14,0,0,0" Fill="{StaticResource Gold}" Opacity="0"/>
                <ContentPresenter/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#10EFE6D0"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bar" Property="Opacity" Value="1"/>
                <Setter TargetName="b" Property="Background" Value="#16EFE6D0"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- On / off: a small slab whose square stone slides; green when on -->
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="18,0,0,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Width="44" Height="22" Background="Transparent">
              <Border x:Name="track" CornerRadius="3" Background="#18EFE6D0" BorderBrush="#40EFE6D0" BorderThickness="1"/>
              <Border x:Name="on" CornerRadius="3" Background="{StaticResource Tunic}" Opacity="0"/>
              <Border x:Name="thumb" Width="16" Height="16" CornerRadius="2" Background="{StaticResource Bone}" HorizontalAlignment="Left" Margin="3,0,0,0">
                <Border.RenderTransform><TranslateTransform x:Name="tx" X="0"/></Border.RenderTransform>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="tx" Storyboard.TargetProperty="X" To="22" Duration="0:0:0.14"/>
                      <DoubleAnimation Storyboard.TargetName="on" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="tx" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.14"/>
                      <DoubleAnimation Storyboard.TargetName="on" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="track" Property="BorderBrush" Value="#80EFE6D0"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Play: a green plaque with a gold line set into it. It darkens when pressed; nothing glows. -->
    <Style x:Key="Play" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="plate" CornerRadius="4">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#4A9E57" Offset="0"/>
                    <GradientStop Color="#2F7A3D" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
              <Border x:Name="shade" CornerRadius="4" Background="#000000" Opacity="0"/>
              <Border CornerRadius="2" Margin="4" BorderBrush="#B3E3C876" BorderThickness="1"/>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="shade" Property="Background" Value="#FFFFFF"/>
                <Setter TargetName="shade" Property="Opacity" Value="0.08"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="shade" Property="Background" Value="#000000"/>
                <Setter TargetName="shade" Property="Opacity" Value="0.18"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A quiet action: words, underlined when the pointer is on them -->
    <Style x:Key="Link" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{StaticResource BoneSoft}"/>
      <Setter Property="FontFamily" Value="{StaticResource Text}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent">
              <ContentPresenter Margin="0,2,0,4" TextElement.Foreground="{TemplateBinding Foreground}"/>
              <Rectangle x:Name="line" Height="1" VerticalAlignment="Bottom" Fill="{StaticResource BoneSoft}" Opacity="0.35"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Bone}"/>
                <Setter TargetName="line" Property="Opacity" Value="1"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Window buttons -->
    <Style x:Key="Chrome" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Width" Value="36"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="3" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#22EFE6D0"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Slider: a line and a small gold lozenge -->
    <Style x:Key="Lozenge" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Grid Width="16" Height="16" Background="Transparent">
              <Rectangle Width="10" Height="10" Fill="{StaticResource Gold}" RenderTransformOrigin="0.5,0.5">
                <Rectangle.RenderTransform><RotateTransform Angle="45"/></Rectangle.RenderTransform>
              </Rectangle>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Line" TargetType="Slider">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Height="22">
              <Rectangle Height="1" Fill="#55EFE6D0" VerticalAlignment="Center"/>
              <Track x:Name="PART_Track" VerticalAlignment="Center">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent" Height="22"><Rectangle Height="2" Fill="{StaticResource Gold}" VerticalAlignment="Center"/></Grid>
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" Height="22"/></ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
                <Track.Thumb><Thumb Style="{StaticResource Lozenge}"/></Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Language list: the chosen name over a line, the list on the same stone -->
    <Style x:Key="ListItem" TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource BoneSoft}"/>
      <Setter Property="FontFamily" Value="{StaticResource Text}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="b" Padding="12,6" Background="Transparent">
              <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="b" Property="Background" Value="#1CEFE6D0"/>
                <Setter Property="Foreground" Value="{StaticResource Bone}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Gold}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="List" TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource Bone}"/>
      <Setter Property="FontFamily" Value="{StaticResource Text}"/>
      <Setter Property="FontSize" Value="14.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="ItemContainerStyle" Value="{StaticResource ListItem}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bb" Background="Transparent" BorderBrush="#55EFE6D0" BorderThickness="0,0,0,1">
                      <Path HorizontalAlignment="Right" Margin="0,0,4,0" VerticalAlignment="Center" Data="M0,0 L5,5 L10,0" Stroke="{StaticResource BoneSoft}" StrokeThickness="1.4"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="bb" Property="BorderBrush" Value="{StaticResource Gold}"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter Margin="0,5,26,7" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" VerticalAlignment="Center"/>
              <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade" Focusable="False">
                <Border Margin="0,4,0,0" CornerRadius="3" Background="#F813231C" BorderBrush="#66C9A24B" BorderThickness="1" Padding="0,4"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="300">
                  <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="5"/>
      <Setter Property="MinWidth" Value="5"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb"><Border CornerRadius="2" Background="#40EFE6D0"/></ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
